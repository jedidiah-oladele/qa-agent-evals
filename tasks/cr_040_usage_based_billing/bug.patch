@@ -0,0 +1,82 @@
+import { describe, expect, it } from "vitest";
+import { type MeteredPlan, type UsageRecord, tieredCharge, usageCharge, usageInPeriod } from "../src/billing";
+import { InvoiceStateError, ValidationError } from "../src/errors";
+import { Invoice } from "../src/invoice";
+import { money } from "../src/money";
+
+const usd = (minor: number) => money(minor, "USD");
+const at = (iso: string, quantity: number): UsageRecord => ({ at: new Date(iso), quantity });
+
+const plan: MeteredPlan = {
+  includedUnits: 100,
+  tiers: [
+    { upTo: 1_000, unitPrice: usd(10) },
+    { upTo: null, unitPrice: usd(5) },
+  ],
+};
+const june = { start: "2026-06-01", end: "2026-07-01" };
+
+describe("usageInPeriod", () => {
+  it("adds up the records that fall inside the period", () => {
+    const records = [at("2026-06-01T00:00:00Z", 5), at("2026-06-15T13:45:00Z", 7), at("2026-06-30T23:59:59Z", 1)];
+    expect(usageInPeriod(records, june)).toBe(13);
+  });
+
+  it("ignores records before the period", () => {
+    expect(usageInPeriod([at("2026-05-31T23:59:59Z", 4), at("2026-06-02T08:00:00Z", 2)], june)).toBe(2);
+  });
+});
+
+describe("tieredCharge", () => {
+  it("charges the first tier rate inside the first tier", () => {
+    expect(tieredCharge(400, plan.tiers)).toEqual(usd(4_000));
+  });
+
+  it("charges the whole first tier at its boundary", () => {
+    expect(tieredCharge(1_000, plan.tiers)).toEqual(usd(10_000));
+  });
+
+  it("accepts tiers in any order and charges nothing for no usage", () => {
+    expect(tieredCharge(0, [...plan.tiers].reverse())).toEqual(usd(0));
+    expect(tieredCharge(10, [...plan.tiers].reverse())).toEqual(usd(100));
+  });
+
+  it("needs at least one tier", () => {
+    expect(() => tieredCharge(1, [])).toThrow(ValidationError);
+  });
+});
+
+describe("usageCharge", () => {
+  it("bills usage above the included units", () => {
+    const records = [at("2026-06-03T10:00:00Z", 300), at("2026-06-20T10:00:00Z", 250)];
+    expect(usageCharge(plan, records, june, new Date("2026-01-01T00:00:00Z"))).toEqual(usd(4_500));
+  });
+
+  it("prorates the included units for a subscription activated mid-period", () => {
+    // Active for 15 of 30 days: 50 included units.
+    const records = [at("2026-06-20T10:00:00Z", 80)];
+    expect(usageCharge(plan, records, june, new Date("2026-06-16T00:00:00Z"))).toEqual(usd(300));
+  });
+});
+
+describe("Invoice.addUsageLine", () => {
+  it("adds a single line for the usage charge", () => {
+    const invoice = new Invoice("USD");
+    expect(invoice.addUsageLine("API calls, June", usd(4_500), 0.2)).toBe(true);
+    expect(invoice.lines).toHaveLength(1);
+    expect(invoice.total).toEqual(usd(5_400));
+  });
+
+  it("skips periods without billable usage", () => {
+    const invoice = new Invoice("USD");
+    expect(invoice.addUsageLine("API calls, June", usd(0), 0.2)).toBe(false);
+    expect(invoice.lines).toHaveLength(0);
+  });
+
+  it("only changes drafts", () => {
+    const invoice = new Invoice("USD");
+    invoice.addLine({ description: "Plan", quantity: 1, unitPrice: usd(1_000), taxRate: 0 });
+    invoice.issue("INV-1", "2026-07-01");
+    expect(() => invoice.addUsageLine("late", usd(0), 0)).toThrow(InvoiceStateError);
+  });
+});
