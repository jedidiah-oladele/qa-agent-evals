diff --git a/tests/test_coupon_limits.py b/tests/test_coupon_limits.py
new file mode 100644
index 0000000..334987d
--- /dev/null
+++ b/tests/test_coupon_limits.py
@@ -0,0 +1,61 @@
+from decimal import Decimal
+
+import pytest
+
+from shopcore import (
+    CouponLimit,
+    CouponRedemptions,
+    DiscountError,
+    Order,
+    PercentageDiscount,
+    PricingEngine,
+    default_tax_table,
+)
+
+
+def make_engine(clock, *limits):
+    coupon = PercentageDiscount(code="SPRING10", percent=Decimal(10))
+    return PricingEngine(default_tax_table(), [coupon], clock=clock, redemptions=CouponRedemptions(limits))
+
+
+def make_order(catalog, customer_id="cust-1", coupons=("spring10",)):
+    order = Order("USD", "US-CA", coupon_codes=tuple(coupons), customer_id=customer_id)
+    order.add(catalog.get("MUG-001"), 2)
+    return order
+
+
+def test_codes_without_limits_are_unlimited(catalog, clock):
+    engine = make_engine(clock)
+    for _ in range(5):
+        order = make_order(catalog)
+        quote = engine.quote(order)
+        assert [a.code for a in quote.applied_discounts] == ["SPRING10"]
+        engine.record_redemptions(order, quote)
+    assert engine.redemptions.redemptions("SPRING10") == 5
+
+
+def test_once_per_customer(catalog, clock):
+    engine = make_engine(clock, CouponLimit("spring10", once_per_customer=True))
+    first = make_order(catalog)
+    quote = engine.quote(first)
+    assert quote.discount_total.amount == Decimal("2.50")
+    engine.record_redemptions(first, quote)
+
+    assert engine.quote(make_order(catalog)).discount_total.is_zero()
+    assert engine.quote(make_order(catalog, customer_id="cust-2")).discount_total.amount == Decimal("2.50")
+
+
+def test_guests_cannot_use_once_per_customer_codes(catalog, clock):
+    engine = make_engine(clock, CouponLimit("SPRING10", once_per_customer=True))
+    assert engine.quote(make_order(catalog, customer_id=None)).discount_total.is_zero()
+
+
+def test_quotes_alone_do_not_use_up_a_code(catalog, clock):
+    engine = make_engine(clock, CouponLimit("SPRING10", once_per_customer=True))
+    for _ in range(3):
+        assert engine.quote(make_order(catalog)).discount_total.amount == Decimal("2.50")
+
+
+def test_max_redemptions_must_be_positive():
+    with pytest.raises(DiscountError):
+        CouponLimit("X", max_redemptions=0)
