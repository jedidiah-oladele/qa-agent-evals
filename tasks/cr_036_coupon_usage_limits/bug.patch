++"""Coupon redemption limits: a cap on total uses and one use per customer.
++
++Limits are keyed by coupon code (case-insensitive, like coupon entry in
++:mod:`shopcore.pricing`). A code without a configured limit can be redeemed
++any number of times.
++"""
++
++from __future__ import annotations
++
++from collections import Counter, defaultdict
++from collections.abc import Iterable
++from dataclasses import dataclass
++
++from .errors import DiscountError
++
++
++def normalize_code(code: str) -> str:
++    return code.strip().upper()
++
++
++@dataclass(frozen=True)
++class CouponLimit:
++    """``max_redemptions``: total uses across all customers (None = unlimited).
++
++    ``once_per_customer``: each customer id may redeem the code once. Guest
++    orders (no customer id) cannot use such a code, because there is no way
++    to tell two guests apart.
++    """
++
++    code: str
++    max_redemptions: int | None = None
++    once_per_customer: bool = False
++
++    def __post_init__(self) -> None:
++        if self.max_redemptions is not None and self.max_redemptions < 1:
++            raise DiscountError(f"{self.code}: max_redemptions must be at least 1")
++
++
++class CouponRedemptions:
++    """In-memory redemption counts for a set of coupon limits."""
++
++    def __init__(self, limits: Iterable[CouponLimit] = ()) -> None:
++        self._limits = {normalize_code(limit.code): limit for limit in limits}
++        self._counts: Counter[str] = Counter()
++        self._customers: defaultdict[str, set[str]] = defaultdict(set)
++
++    def can_redeem(self, code: str, customer_id: str | None) -> bool:
++        key = normalize_code(code)
++        limit = self._limits.get(key)
++        if limit is None:
++            return True
++        if limit.max_redemptions is not None and self._counts[key] > limit.max_redemptions:
++            return False
++        if limit.once_per_customer:
++            if customer_id is None:
++                return False
++            if customer_id in self._customers[key]:
++                return False
++        return True
++
++    def record(self, code: str, customer_id: str | None) -> None:
++        key = normalize_code(code)
++        self._counts[key] += 1
++        if customer_id is not None:
++            self._customers[key].add(customer_id)
++
++    def redemptions(self, code: str) -> int:
++        return self._counts[normalize_code(code)]
