+ from .errors import CurrencyMismatchError
+ from .money import Money, sum_money
+@@ -56,18 +57,35 @@ class PricingEngine:
+         shipping: ShippingPolicy | None = None,
+         rounding: TaxRounding = TaxRounding.PER_LINE,
+         clock: Clock | None = None,
++        redemptions: CouponRedemptions | None = None,
+     ) -> None:
+         self.tax_table = tax_table
+         self.discounts = list(discounts)
+         self.shipping = shipping
+         self.rounding = rounding
+         self.clock = clock or SystemClock()
++        self.redemptions = redemptions
+ 
+     def eligible_discounts(self, order: Order) -> list[Discount]:
+-        """Auto-applied discounts plus those whose code the customer entered."""
+-        entered = {code.strip().upper() for code in order.coupon_codes}
++        """Auto-applied discounts plus those whose code the customer entered.
++
++        Entered codes that have reached a redemption limit are skipped.
++        """
++        entered = {normalize_code(code) for code in order.coupon_codes}
++        if self.redemptions is not None:
++            entered = {code for code in entered if self.redemptions.can_redeem(code, order.customer_id)}
+         return [d for d in self.discounts if d.auto_apply or d.code.upper() in entered]
+ 
++    def record_redemptions(self, order: Order, quote: Quote) -> None:
++        """Count the order's coupons against their limits once it has been paid.
++
++        Call this after payment succeeds, with the quote the customer paid.
++        """
++        if self.redemptions is None:
++            return
++        for code in dict.fromkeys(normalize_code(c) for c in order.coupon_codes):
++            self.redemptions.record(code, order.customer_id)
++
+     def quote(self, order: Order) -> Quote:
+         currency = order.currency
+         region = self.tax_table.get(order.region)
