--- a/src/shopcore/clock.py
+++ b/src/shopcore/clock.py
@@ -12,6 +12,18 @@ class Clock(Protocol):
         ...
 
 
+def utc_now() -> datetime:
+    """The current UTC time, for code paths that have no injected clock."""
+    return datetime.utcnow()
+
+
+def expiry_after(ttl: timedelta, start: datetime | None = None) -> datetime:
+    """The instant ``ttl`` after ``start`` (default: the current UTC time)."""
+    if ttl <= timedelta(0):
+        raise ValueError("ttl must be positive")
+    return (start or utc_now()) + ttl
+
+
 class SystemClock:
     """Wall-clock time in UTC."""
 
