+def parse_expiry(value: str | datetime | None) -> datetime | None:
+    """Normalise an ``expires_at`` value read from configuration (YAML or JSON).
+
+    Accepts ``None``, a datetime, an ISO 8601 date (the discount then runs
+    through that whole day, UTC) or an ISO 8601 date-time. Values without a
+    UTC offset are taken to be UTC.
+    """
+    if value is None or isinstance(value, datetime):
+        return value
+    text = value.strip()
+    if len(text) == 10:
+        return datetime.fromisoformat(text) + timedelta(days=1)
+    return datetime.fromisoformat(text)
+
+
 def _allocate(amount: Money, lines_remaining: Sequence[Money], eligible: Sequence[bool]) -> list[Money]:
     """Spread ``amount`` over eligible lines in proportion to their remaining value."""
     currency = amount.currency
