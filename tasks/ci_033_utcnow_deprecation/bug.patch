diff --git a/tests/test_discounts_config.py b/tests/test_discounts_config.py
new file mode 100644
index 0000000..ceced56
--- /dev/null
+++ b/tests/test_discounts_config.py
@@ -0,0 +1,37 @@
+from datetime import UTC, datetime
+from decimal import Decimal
+
+from shopcore import LineItem, Money, PercentageDiscount, Product, apply_discounts
+from shopcore.discounts import parse_expiry
+
+
+def spring_sale(expires: str) -> PercentageDiscount:
+    return PercentageDiscount(code="SPRING", percent=Decimal(10), auto_apply=True, expires_at=parse_expiry(expires))
+
+
+def lines() -> list[LineItem]:
+    return [LineItem(Product("MUG-001", "Enamel mug", Money.of("12.50", "USD")), 2)]
+
+
+def test_offset_is_converted_to_utc():
+    assert parse_expiry("2026-03-31T18:00:00+02:00") == datetime(2026, 3, 31, 16, 0, tzinfo=UTC)
+
+
+def test_none_and_datetimes_pass_through():
+    moment = datetime(2026, 3, 31, 12, 0, tzinfo=UTC)
+    assert parse_expiry(None) is None
+    assert parse_expiry(moment) == moment
+
+
+def test_date_only_runs_through_the_whole_day():
+    discount = spring_sale("2026-03-31")
+    last_minute = apply_discounts(lines(), [discount], now=datetime(2026, 3, 31, 23, 59, tzinfo=UTC))
+    assert last_minute.total("USD") == Money.of("2.50", "USD")
+    next_day = apply_discounts(lines(), [discount], now=datetime(2026, 4, 1, 0, 0, tzinfo=UTC))
+    assert next_day.total("USD").is_zero()
+
+
+def test_time_without_offset_is_utc():
+    discount = spring_sale("2026-03-31T18:00")
+    before = apply_discounts(lines(), [discount], now=datetime(2026, 3, 31, 17, 59, tzinfo=UTC))
+    assert before.total("USD") == Money.of("2.50", "USD")
diff --git a/tests/test_inventory_extend.py b/tests/test_inventory_extend.py
new file mode 100644
index 0000000..4111a7f
--- /dev/null
+++ b/tests/test_inventory_extend.py
@@ -0,0 +1,41 @@
+from datetime import timedelta
+
+import pytest
+
+from shopcore import Inventory, ReservationError
+
+
+@pytest.fixture
+def inventory(clock):
+    inv = Inventory(clock=clock, default_ttl=timedelta(minutes=15))
+    inv.set_stock("TEE-001", 5)
+    return inv
+
+
+def test_extend_restarts_the_hold_from_now(inventory, clock):
+    reservation = inventory.reserve("TEE-001", 2)
+    clock.advance(timedelta(minutes=10))
+    inventory.extend(reservation.id, timedelta(minutes=15))
+    assert reservation.expires_at == clock.now() + timedelta(minutes=15)
+
+
+def test_extended_hold_keeps_stock_reserved(inventory, clock):
+    reservation = inventory.reserve("TEE-001", 2)
+    clock.advance(timedelta(minutes=10))
+    inventory.extend(reservation.id, timedelta(minutes=15))
+    clock.advance(timedelta(minutes=10))
+    assert inventory.available("TEE-001") == 3
+
+
+def test_cannot_extend_a_released_reservation(inventory):
+    reservation = inventory.reserve("TEE-001", 1)
+    inventory.release(reservation.id)
+    with pytest.raises(ReservationError):
+        inventory.extend(reservation.id, timedelta(minutes=5))
+
+
+def test_cannot_extend_after_expiry(inventory, clock):
+    reservation = inventory.reserve("TEE-001", 1)
+    clock.advance(timedelta(minutes=16))
+    with pytest.raises(ReservationError):
+        inventory.extend(reservation.id, timedelta(minutes=5))
