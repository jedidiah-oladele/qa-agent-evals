diff --git a/tests/client-auth.test.ts b/tests/client-auth.test.ts
new file mode 100644
index 0000000..0458cef
--- /dev/null
+++ b/tests/client-auth.test.ts
@@ -0,0 +1,83 @@
+import { describe, expect, it } from "vitest";
+import { type AccessToken, LedgerClient } from "../src/client";
+import { ApiError } from "../src/errors";
+import { fakeFetch, json, recordingSleep } from "./helpers/fake-fetch";
+
+const NOW = Date.parse("2026-10-20T12:00:00Z");
+
+function setup(fake: ReturnType<typeof fakeFetch>, tokens: AccessToken[], extra: { apiKeyExpiresAt?: number; maxRetries?: number } = {}) {
+  let refreshes = 0;
+  const refreshToken = async () => {
+    const next = tokens[refreshes++];
+    if (!next) throw new Error("no more tokens");
+    return next;
+  };
+  const client = new LedgerClient({
+    baseUrl: "https://api.ledger.test",
+    apiKey: "tok_initial",
+    fetch: fake.fetch,
+    sleep: recordingSleep().sleep,
+    now: () => NOW,
+    refreshToken,
+    ...extra,
+  });
+  return { client, refreshes: () => refreshes };
+}
+
+const auth = (call: { init: RequestInit }) => (call.init.headers as Record<string, string>).Authorization;
+
+describe("access token refresh", () => {
+  it("refreshes after a 401 and resends with the new token", async () => {
+    const fake = fakeFetch(json(401, {}), json(200, { id: "inv_1" }));
+    const { client, refreshes } = setup(fake, [{ value: "tok_2", expiresAt: NOW + 3_600_000 }]);
+    await expect(client.request("GET", "/invoices/inv_1")).resolves.toEqual({ id: "inv_1" });
+    expect(fake.calls.map(auth)).toEqual(["Bearer tok_initial", "Bearer tok_2"]);
+    expect(refreshes()).toBe(1);
+  });
+
+  it("refreshes before sending when the token is about to expire", async () => {
+    const fake = fakeFetch(json(200, {}));
+    const { client, refreshes } = setup(fake, [{ value: "tok_2", expiresAt: NOW + 3_600_000 }], {
+      apiKeyExpiresAt: NOW + 10_000,
+    });
+    await client.request("GET", "/x");
+    expect(fake.calls.map(auth)).toEqual(["Bearer tok_2"]);
+    expect(refreshes()).toBe(1);
+  });
+
+  it("keeps using a token that is still valid", async () => {
+    const fake = fakeFetch(json(200, {}), json(200, {}));
+    const { client, refreshes } = setup(fake, [], { apiKeyExpiresAt: NOW + 3_600_000 });
+    await client.request("GET", "/x");
+    await client.request("GET", "/y");
+    expect(refreshes()).toBe(0);
+  });
+
+  it("gives up when the refreshed token is rejected too", async () => {
+    const fake = fakeFetch(json(401, {}), json(401, {}));
+    const { client } = setup(fake, [{ value: "tok_2", expiresAt: NOW + 3_600_000 }]);
+    const error = await client.request("GET", "/x").catch((e) => e);
+    expect(error).toBeInstanceOf(ApiError);
+    expect(error).toMatchObject({ status: 401 });
+    expect(fake.calls).toHaveLength(2);
+  });
+
+  it("does not count the re-send against maxRetries", async () => {
+    const fake = fakeFetch(json(401, {}), json(503, {}), json(503, {}), json(200, { ok: true }));
+    const { client } = setup(fake, [{ value: "tok_2", expiresAt: NOW + 3_600_000 }], { maxRetries: 2 });
+    await expect(client.request("GET", "/x")).resolves.toEqual({ ok: true });
+  });
+
+  it("shares one refresh between concurrent 401s", async () => {
+    const fake = fakeFetch(json(401, {}), json(401, {}), json(200, { n: 1 }), json(200, { n: 2 }));
+    const { client, refreshes } = setup(fake, [{ value: "tok_2", expiresAt: NOW + 3_600_000 }]);
+    await Promise.all([client.request("GET", "/a"), client.request("GET", "/b")]);
+    expect(refreshes()).toBe(1);
+  });
+
+  it("surfaces 401 as ApiError when no refresh function is configured", async () => {
+    const fake = fakeFetch(json(401, { error: { code: "unauthorized", message: "bad key" } }));
+    const client = new LedgerClient({ baseUrl: "https://api.ledger.test", apiKey: "k", fetch: fake.fetch });
+    await expect(client.request("GET", "/x")).rejects.toMatchObject({ status: 401, code: "unauthorized" });
+  });
+});
