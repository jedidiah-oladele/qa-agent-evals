@@ -0,0 +1,73 @@
+import { describe, expect, it } from "vitest";
+import { InvoiceStateError, ValidationError } from "../src/errors";
+import { Invoice } from "../src/invoice";
+import { money } from "../src/money";
+
+function paidInvoice(): Invoice {
+  const invoice = new Invoice("USD");
+  invoice.addLine({ description: "Seat licence", quantity: 5, unitPrice: money(2_000, "USD"), taxRate: 0.2 });
+  invoice.addLine({ description: "Onboarding", quantity: 1, unitPrice: money(15_000, "USD"), taxRate: 0 });
+  invoice.issue("INV-2026-0050", "2026-09-01");
+  invoice.recordPayment(invoice.total, "2026-09-10"); // 12 000 + 2 000 tax + 15 000
+  return invoice;
+}
+
+describe("Invoice.creditNote", () => {
+  it("credits units of a line at their invoiced price and tax", () => {
+    const invoice = paidInvoice();
+    const note = invoice.creditNote("CN-2026-0001", "2026-09-15", "two seats unused", [{ line: 0, quantity: 2 }]);
+    expect(note.net.minor).toBe(4_000);
+    expect(note.tax.minor).toBe(800);
+    expect(note.total.minor).toBe(4_800);
+    expect(invoice.amountCredited.minor).toBe(4_800);
+    expect(invoice.status).toBe("paid");
+  });
+
+  it("combines several lines in one note", () => {
+    const invoice = paidInvoice();
+    const note = invoice.creditNote("CN-1", "2026-09-15", "cancelled", [
+      { line: 0, quantity: 1 },
+      { line: 1, quantity: 1 },
+    ]);
+    expect(note.lines).toHaveLength(2);
+    expect(note.total.minor).toBe(2_400 + 15_000);
+  });
+
+  it("does not credit more units than were invoiced", () => {
+    const invoice = paidInvoice();
+    invoice.creditNote("CN-1", "2026-09-15", "unused", [{ line: 0, quantity: 4 }]);
+    expect(() => invoice.creditNote("CN-2", "2026-09-16", "unused", [{ line: 0, quantity: 2 }])).toThrow(ValidationError);
+    expect(() =>
+      invoice.creditNote("CN-3", "2026-09-16", "dup", [
+        { line: 1, quantity: 1 },
+        { line: 1, quantity: 1 },
+      ]),
+    ).toThrow(ValidationError);
+  });
+
+  it("cannot credit more than has been paid", () => {
+    const invoice = new Invoice("USD");
+    invoice.addLine({ description: "Plan", quantity: 2, unitPrice: money(5_000, "USD"), taxRate: 0 });
+    invoice.issue("INV-7", "2026-09-01");
+    invoice.recordPayment(money(5_000, "USD"), "2026-09-02");
+    expect(() => invoice.creditNote("CN-1", "2026-09-03", "refund", [{ line: 0, quantity: 2 }])).toThrow(
+      ValidationError,
+    );
+  });
+
+  it("validates its inputs", () => {
+    const invoice = paidInvoice();
+    expect(() => invoice.creditNote("CN-1", "2026-09-15", " ", [{ line: 0, quantity: 1 }])).toThrow(ValidationError);
+    expect(() => invoice.creditNote("CN-1", "2026-09-15", "x", [])).toThrow(ValidationError);
+    expect(() => invoice.creditNote("CN-1", "2026-09-15", "x", [{ line: 9, quantity: 1 }])).toThrow(ValidationError);
+    expect(() => invoice.creditNote("CN-1", "2026-08-01", "x", [{ line: 0, quantity: 1 }])).toThrow(ValidationError);
+  });
+
+  it("is only possible once the invoice is issued", () => {
+    const invoice = new Invoice("USD");
+    invoice.addLine({ description: "Plan", quantity: 1, unitPrice: money(5_000, "USD"), taxRate: 0 });
+    expect(() => invoice.creditNote("CN-1", "2026-09-03", "refund", [{ line: 0, quantity: 1 }])).toThrow(
+      InvoiceStateError,
+    );
+  });
+});
