diff --git a/tests/test_inventory_batch.py b/tests/test_inventory_batch.py
new file mode 100644
index 0000000..1041019
--- /dev/null
+++ b/tests/test_inventory_batch.py
@@ -0,0 +1,62 @@
+import pytest
+
+from shopcore import InsufficientStockError, Inventory, ReservationStatus
+
+
+@pytest.fixture
+def inventory(clock):
+    inv = Inventory(clock=clock)
+    inv.set_stock("TEE-001", 10)
+    inv.set_stock("MUG-001", 3)
+    inv.set_stock("BOOK-042", 0)
+    return inv
+
+
+def test_full_batch_reserves_everything(inventory):
+    batch = inventory.reserve_batch({"TEE-001": 2, "MUG-001": 3})
+    assert batch.complete
+    assert batch.quantity("TEE-001") == 2
+    assert batch.quantity("MUG-001") == 3
+    assert inventory.available("MUG-001") == 0
+
+
+def test_all_or_nothing_batch_raises_on_shortage(inventory):
+    with pytest.raises(InsufficientStockError):
+        inventory.reserve_batch({"MUG-001": 4})
+    assert inventory.available("MUG-001") == 3
+
+
+def test_partial_batch_reserves_what_is_available(inventory):
+    batch = inventory.reserve_batch({"TEE-001": 2, "MUG-001": 5, "BOOK-042": 1}, partial=True)
+    assert not batch.complete
+    assert batch.shortfall == {"MUG-001": 2, "BOOK-042": 1}
+    assert batch.quantity("MUG-001") == 3
+    assert batch.quantity("BOOK-042") == 0
+    assert inventory.available("TEE-001") == 8
+
+
+def test_partial_batch_when_stock_was_cut_below_reservations(inventory):
+    inventory.reserve("MUG-001", 3)
+    inventory.set_stock("MUG-001", 1)
+    batch = inventory.reserve_batch({"MUG-001": 2}, partial=True)
+    assert batch.reservations == ()
+    assert batch.shortfall == {"MUG-001": 2}
+
+
+def test_release_batch(inventory):
+    batch = inventory.reserve_batch({"TEE-001": 2, "MUG-001": 1})
+    inventory.commit(batch.reservations[0].id)
+    inventory.release_batch(batch)
+    assert [r.status for r in batch.reservations] == [ReservationStatus.COMMITTED, ReservationStatus.RELEASED]
+
+
+@pytest.mark.parametrize("qty", [0, -1])
+def test_quantities_must_be_positive(inventory, qty):
+    with pytest.raises(ValueError):
+        inventory.reserve_batch({"TEE-001": qty})
+
+
+def test_unknown_sku_fails_before_anything_is_held(inventory):
+    with pytest.raises(KeyError):
+        inventory.reserve_batch({"TEE-001": 1, "NOPE": 1}, partial=True)
+    assert inventory.active_reservations() == []
