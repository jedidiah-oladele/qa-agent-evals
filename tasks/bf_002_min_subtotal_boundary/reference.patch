diff --git a/tests/test_discounts.py b/tests/test_discounts.py
index 775d58f..f8cc16d 100644
--- a/tests/test_discounts.py
+++ b/tests/test_discounts.py
@@ -121,3 +121,13 @@ def test_discount_never_exceeds_line_value(catalog):
 
 def test_no_lines_no_discount():
     assert apply_discounts([], [PercentageDiscount(code="X", percent=Decimal(5))], now=NOW).per_line == []
+
+
+def test_min_subtotal_is_inclusive(catalog):
+    lines = [LineItem(catalog.get("MUG-001"), 4)]  # exactly 50.00
+    percentage = PercentageDiscount(code="SPEND50", percent=Decimal(10), min_subtotal=usd("50"))
+    fixed = FixedAmountDiscount(code="FIVE-OVER-50", amount=usd("5"), min_subtotal=usd("50"))
+    assert apply_discounts(lines, [percentage], now=NOW).total("USD") == usd("5.00")
+    assert apply_discounts(lines, [fixed], now=NOW).total("USD") == usd("5.00")
+    below = [LineItem(catalog.get("MUG-001"), 3), LineItem(catalog.get("BEAN-250"), 1)]  # 47.45
+    assert apply_discounts(below, [percentage], now=NOW).total("USD").is_zero()
