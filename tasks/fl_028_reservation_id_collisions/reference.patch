 from __future__ import annotations
 
-import random
+import uuid
 from collections.abc import Mapping
 from dataclasses import dataclass
 from datetime import datetime, timedelta
@@ -87,8 +87,10 @@ class Inventory:
     def _new_id(self) -> str:
         # Not a per-instance counter: every warehouse worker has its own Inventory
         # and they all append to one reservation log, so counters starting at
-        # RSV-000001 in each worker collided there.
-        return f"RSV-{random.randint(0, 999_999):06d}"
+        # RSV-000001 in each worker collided there. Random 6-digit ids were no
+        # better: they collide by the birthday paradox after a few hundred holds and
+        # repeat whenever someone seeds the global RNG. A UUID4 has neither problem.
+        return f"RSV-{uuid.uuid4().hex}"
 
     def _expiry(self, now: datetime, ttl: timedelta | None) -> datetime | None:
         ttl = ttl if ttl is not None else self._default_ttl
