+def test_flash_sale_single_unit_holds(clock):
+    inventory = Inventory(clock=clock)
+    inventory.set_stock("TICKET-1", 2000)
+    holds = [inventory.reserve("TICKET-1", 1) for _ in range(500)]
+    assert inventory.reserved("TICKET-1") == 500
+    for hold in holds[::2]:
