-"""shopcore: order pricing, discounts, tax, inventory, payments and CSV import."""
+"""shopcore: order pricing, discounts, tax, inventory, payments and CSV import.
+
+Public names are re-exported here but loaded lazily (PEP 562), so
+``import shopcore`` stays cheap: a CSV-only script does not pay for importing
+asyncio and the payment client, and ``from shopcore import Money`` only loads
+:mod:`shopcore.money`.
+"""
+
+from __future__ import annotations
+
+import importlib
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:  # pragma: no cover - for type checkers and IDEs only
+    from .catalog import Catalog, Product
+    from .clock import Clock, FixedClock, SystemClock
+    from .discounts import (
+        AppliedDiscount,
+        BuyXGetYDiscount,
+        Discount,
+        FixedAmountDiscount,
+        PercentageDiscount,
+        apply_discounts,
+    )
+    from .errors import (
+        CsvFormatError,
+        CurrencyMismatchError,
+        DiscountError,
+        InsufficientStockError,
+        PaymentError,
+        PaymentRetryExhaustedError,
+        PermanentPaymentError,
+        ReservationError,
+        ShopcoreError,
+        TaxConfigError,
+        TransientPaymentError,
+        UnknownCurrencyError,
+        UnknownSkuError,
+    )
+    from .inventory import Inventory, Reservation, ReservationStatus
+    from .money import Money, sum_money
+    from .order import LineItem, Order
+    from .payments import ChargeRequest, ChargeResult, PaymentClient, RetryPolicy
+    from .pricing import PricedLine, PricingEngine, Quote
+    from .shipping import ShippingPolicy, WeightTier
+    from .tax import TaxRegion, TaxRounding, TaxTable, default_tax_table
+
+_EXPORTS: dict[str, tuple[str, ...]] = {
+    "catalog": ("Catalog", "Product"),
+    "clock": ("Clock", "FixedClock", "SystemClock"),
+    "discounts": (
+        "AppliedDiscount",
+        "BuyXGetYDiscount",
+        "Discount",
+        "FixedAmountDiscount",
+        "PercentageDiscount",
+        "apply_discounts",
+    ),
+    "errors": (
+        "CsvFormatError",
+        "CurrencyMismatchError",
+        "DiscountError",
+        "InsufficientStockError",
+        "PaymentError",
+        "PaymentRetryExhaustedError",
+        "PermanentPaymentError",
+        "ReservationError",
+        "ShopcoreError",
+        "TaxConfigError",
+        "TransientPaymentError",
+        "UnknownCurrencyError",
+        "UnknownSkuError",
+    ),
+    "inventory": ("Inventory", "Reservation", "ReservationStatus"),
+    "money": ("Money", "sum_money"),
+    "order": ("LineItem", "Order"),
+    "payments": ("ChargeRequest", "ChargeResult", "PaymentClient", "RetryPolicy"),
+    "pricing": ("PricedLine", "PricingEngine", "Quote"),
+    "shipping": ("ShippingPolicy", "WeightTier"),
+    "tax": ("TaxRegion", "TaxRounding", "TaxTable", "default_tax_table"),
+}
+_MODULE_OF = {name: module for module, names in _EXPORTS.items() for name in names}
+
+
+def __getattr__(name: str) -> Any:
+    module = _MODULE_OF.get(name)
+    if module is None:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    value = getattr(importlib.import_module(f".{module}", __name__), name)
+    globals()[name] = value  # cache: later lookups skip __getattr__
+    return value
+
+
+def __dir__() -> list[str]:
+    return sorted(set(globals()) | set(_MODULE_OF))
 
