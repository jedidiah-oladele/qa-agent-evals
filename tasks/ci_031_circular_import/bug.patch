+from .money import Money, round_half_up, sum_money
+from .order import LineItem, Order
 from .shipping import ShippingPolicy
 from .tax import TaxRounding, TaxTable, compute_taxes
 
 
+def total_weight_grams(lines: Sequence[LineItem]) -> int:
+    """Shipping weight of ``lines`` in grams (unit weight times quantity)."""
+    return sum(line.weight_grams for line in lines)
+
+
+def round_to_minor(amount: Decimal, currency: str) -> Money:
+    """``amount`` as :class:`Money`, rounded to the currency's minor unit (half up)."""
+    return Money(round_half_up(amount, currency), currency)
+
+
