 import pytest
@@ -121,3 +121,16 @@ def test_discount_never_exceeds_line_value(catalog):
 
 def test_no_lines_no_discount():
     assert apply_discounts([], [PercentageDiscount(code="X", percent=Decimal(5))], now=NOW).per_line == []
+
+
+def test_valid_through_covers_the_last_day(lines):
+    # NOW is midday on 14 March (UTC), the last day of the campaign.
+    spring = PercentageDiscount(code="SPRING", percent=Decimal(10), valid_through=date(2026, 3, 14))
+    assert apply_discounts(lines, [spring], now=NOW).total("USD") == usd("5.25")
+    assert apply_discounts(lines, [spring], now=NOW + timedelta(days=1)).total("USD").is_zero()
+
+
+def test_earlier_of_expires_at_and_valid_through_wins():
+    both = FixedAmountDiscount(code="X", amount=usd("1"), expires_at=NOW, valid_through=date(2026, 3, 20))
+    assert both.ends_at() == NOW
+    assert FixedAmountDiscount(code="Y", amount=usd("1")).ends_at() is None
