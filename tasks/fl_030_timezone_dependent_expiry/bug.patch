@@ -34,9 +36,25 @@ class Discount(ABC):
     stackable: bool = True
     auto_apply: bool = False
     expires_at: datetime | None = None
+    valid_through: date | None = None
+
+    def ends_at(self) -> datetime | None:
+        """The instant the discount stops applying, or None if it never does.
+
+        ``valid_through`` ends at the following midnight UTC. When both
+        ``expires_at`` and ``valid_through`` are set, the earlier end wins.
+        """
+        ends = []
+        if self.expires_at is not None:
+            ends.append(self.expires_at)
+        if self.valid_through is not None:
+            next_midnight = datetime.combine(self.valid_through + timedelta(days=1), time.min)
+            ends.append(next_midnight.astimezone(UTC))
+        return min(ends) if ends else None
 
     def is_active(self, now: datetime) -> bool:
-        return self.expires_at is None or now < self.expires_at
+        end = self.ends_at()
+        return end is None or now < end
 
