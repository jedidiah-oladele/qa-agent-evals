+import { type Money, multiply, subtract, zero } from "./money";
 
 export type Interval = "monthly" | "quarterly" | "yearly";
 
@@ -65,3 +65,48 @@ export function prorate(price: Money, period: Period, activeFrom: ISODate, activ
   if (overlap >= total) return price;
   return multiply(price, overlap / total);
 }
+
+export interface PlanChange {
+  readonly oldPrice: Money;
+  readonly newPrice: Money;
+  readonly anchor: ISODate;
+  readonly interval: Interval;
+  /** First day on the new plan. */
+  readonly changeOn: ISODate;
+}
+
+export interface Adjustment {
+  readonly period: Period;
+  /** Unused time on the old plan, returned to the customer. */
+  readonly credit: Money;
+  /** Remaining time on the new plan. */
+  readonly charge: Money;
+  /** `charge - credit`; negative means the customer is owed money. */
+  readonly net: Money;
+}
+
+/**
+ * Mid-period plan change: credit the unused part of the old plan and charge
+ * the new plan for the rest of the same period. Both sides use the same day
+ * count so an upgrade and an immediate downgrade cancel out.
+ */
+export function planChangeAdjustment(change: PlanChange): Adjustment {
+  const { oldPrice, newPrice, anchor, interval, changeOn } = change;
+  if (oldPrice.currency !== newPrice.currency) {
+    throw new CurrencyMismatchError(oldPrice.currency, newPrice.currency);
+  }
+  if (compareDates(changeOn, anchor) < 0) {
+    throw new ValidationError(`${changeOn} is before the billing anchor ${anchor}`);
+  }
+  // Walk forward one billing period at a time until we reach the one containing changeOn.
+  let start = anchor;
+  let end = addMonths(anchor, MONTHS[interval]);
+  while (compareDates(changeOn, end) >= 0) {
+    start = end;
+    end = addMonths(start, MONTHS[interval]);
+  }
+  const period: Period = { start, end };
+  const credit = prorate(oldPrice, period, changeOn, period.end);
+  const charge = prorate(newPrice, period, changeOn, period.end);
+  return { period, credit, charge, net: subtract(charge, credit) };
+}
diff --git a/tests/billing-plan-change.test.ts b/tests/billing-plan-change.test.ts
new file mode 100644
index 0000000..c8a2872
--- /dev/null
+++ b/tests/billing-plan-change.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+import { planChangeAdjustment } from "../src/billing";
+import { CurrencyMismatchError } from "../src/errors";
+import { money } from "../src/money";
+
+describe("planChangeAdjustment", () => {
+  it("credits unused old plan and charges the new plan for the rest of the period", () => {
+    const result = planChangeAdjustment({
+      oldPrice: money(3000, "USD"),
+      newPrice: money(6000, "USD"),
+      anchor: "2026-01-01",
+      interval: "monthly",
+      changeOn: "2026-04-21", // 10 of 30 April days remain
+    });
+    expect(result.period).toEqual({ start: "2026-04-01", end: "2026-05-01" });
+    expect(result.credit.minor).toBe(1000);
+    expect(result.charge.minor).toBe(2000);
+    expect(result.net.minor).toBe(1000);
+  });
+
+  it("gives a negative net for downgrades", () => {
+    const result = planChangeAdjustment({
+      oldPrice: money(6000, "USD"),
+      newPrice: money(3000, "USD"),
+      anchor: "2026-01-01",
+      interval: "monthly",
+      changeOn: "2026-04-21",
+    });
+    expect(result.net.minor).toBe(-1000);
+  });
+
+  it("changing on the first day of a period swaps the full price", () => {
+    const result = planChangeAdjustment({
+      oldPrice: money(1000, "EUR"),
+      newPrice: money(2500, "EUR"),
+      anchor: "2026-01-31",
+      interval: "monthly",
+      changeOn: "2026-02-28",
+    });
+    expect(result.period.start).toBe("2026-02-28");
+    expect(result.credit.minor).toBe(1000);
+    expect(result.charge.minor).toBe(2500);
+  });
+
+  it("works for yearly plans", () => {
+    const result = planChangeAdjustment({
+      oldPrice: money(36500, "USD"),
+      newPrice: money(73000, "USD"),
+      anchor: "2025-07-01",
+      interval: "yearly",
+      changeOn: "2026-06-26", // 5 of 365 days remain
+    });
+    expect(result.credit.minor).toBe(500);
+    expect(result.charge.minor).toBe(1000);
+  });
+
+  it("rejects mixed currencies", () => {
+    expect(() =>
+      planChangeAdjustment({
+        oldPrice: money(1, "USD"),
+        newPrice: money(1, "EUR"),
+        anchor: "2026-01-01",
+        interval: "monthly",
+        changeOn: "2026-01-05",
+      }),
+    ).toThrow(CurrencyMismatchError);
+  });
+});
