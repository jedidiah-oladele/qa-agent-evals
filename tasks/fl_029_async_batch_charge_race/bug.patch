 )
 from shopcore.testing import RecordingSleep, ScriptedGateway
 
@@ -124,3 +125,33 @@ def test_charge_many_validates_concurrency():
     client, _, _ = make_client([])
     with pytest.raises(ValueError):
         asyncio.run(client.charge_many([], concurrency=0))
+
+
+class FlakyNetworkGateway:
+    """A gateway that times out on about 3% of calls, like production does."""
+
+    def __init__(self):
+        self.captures = {}
+
+    async def charge(self, amount, token, idempotency_key):
+        if idempotency_key in self.captures:
+            return self.captures[idempotency_key][0]
+        if random.random() < 0.03:
+            raise TransientPaymentError("gateway timeout")
+        charge_id = f"ch_{token}"
+        self.captures[idempotency_key] = (charge_id, amount)
+        return charge_id
+
+
+async def yield_instead_of_sleeping(seconds):
+    await asyncio.sleep(0)
+
+
+def test_charge_many_survives_occasional_gateway_timeouts():
+    gateway = FlakyNetworkGateway()
+    client = PaymentClient(gateway, RetryPolicy(max_attempts=6), sleep=yield_instead_of_sleeping)
+    requests = [ChargeRequest(usd(str(n)), f"tok_{n}") for n in range(1, 13)]
+    results = asyncio.run(client.charge_many(requests, concurrency=4))
+    assert [r.charge_id for r in results] == [f"ch_tok_{n}" for n in range(1, 13)]
+    assert len({r.idempotency_key for r in results}) == 12
+    assert sorted(amount.amount for _, amount in gateway.captures.values()) == [r.amount.amount for r in requests]
