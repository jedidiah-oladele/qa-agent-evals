diff --git a/tests/billing.test.ts b/tests/billing.test.ts
new file mode 100644
index 0000000..5d1994b
--- /dev/null
+++ b/tests/billing.test.ts
@@ -0,0 +1,206 @@
+import { describe, expect, it } from "vitest";
+import {
+  billingPeriods,
+  nthPeriod,
+  periodContaining,
+  periodDays,
+  planChangeAdjustment,
+  prorate,
+} from "../src/billing";
+import { CurrencyMismatchError, ValidationError } from "../src/errors";
+import { money } from "../src/money";
+
+describe("periods", () => {
+  it("computes the nth monthly period from the anchor", () => {
+    expect(nthPeriod("2026-01-15", 0, "monthly")).toEqual({ start: "2026-01-15", end: "2026-02-15" });
+    expect(nthPeriod("2026-01-15", 2, "monthly")).toEqual({ start: "2026-03-15", end: "2026-04-15" });
+  });
+
+  it("does not drift for month-end anchors", () => {
+    const periods = billingPeriods("2026-01-31", "2026-06-01", "monthly");
+    expect(periods.map((p) => p.start)).toEqual(["2026-01-31", "2026-02-28", "2026-03-31", "2026-04-30", "2026-05-31"]);
+    expect(nthPeriod("2026-01-31", 1, "monthly")).toEqual({ start: "2026-02-28", end: "2026-03-31" });
+    expect(nthPeriod("2026-01-31", 2, "monthly").end).toBe("2026-04-30");
+  });
+
+  it("each period ends where the next one starts", () => {
+    const periods = billingPeriods("2026-01-31", "2027-01-31", "monthly");
+    expect(periods).toHaveLength(12);
+    for (let i = 1; i < periods.length; i++) {
+      expect(periods[i]!.start).toBe(periods[i - 1]!.end);
+    }
+  });
+
+  it("supports quarterly and yearly intervals", () => {
+    expect(nthPeriod("2026-02-01", 1, "quarterly")).toEqual({ start: "2026-05-01", end: "2026-08-01" });
+    expect(nthPeriod("2025-11-30", 1, "quarterly")).toEqual({ start: "2026-02-28", end: "2026-05-30" });
+    expect(nthPeriod("2024-02-29", 1, "yearly")).toEqual({ start: "2025-02-28", end: "2026-02-28" });
+    expect(nthPeriod("2024-02-29", 4, "yearly")).toEqual({ start: "2028-02-29", end: "2029-02-28" });
+  });
+
+  it("billingPeriods stops before `until`", () => {
+    expect(billingPeriods("2026-01-01", "2026-03-01", "monthly")).toHaveLength(2);
+    expect(billingPeriods("2026-01-01", "2026-03-02", "monthly")).toHaveLength(3);
+    expect(billingPeriods("2026-01-01", "2026-01-02", "monthly")).toHaveLength(1);
+    expect(billingPeriods("2026-01-01", "2026-01-01", "monthly")).toEqual([]);
+    expect(billingPeriods("2026-01-01", "2025-06-01", "monthly")).toEqual([]);
+  });
+
+  it("finds the period containing a date", () => {
+    expect(periodContaining("2026-01-31", "2026-03-30", "monthly")).toEqual({
+      start: "2026-02-28",
+      end: "2026-03-31",
+    });
+    expect(periodContaining("2026-01-01", "2026-01-01", "yearly")).toEqual({ start: "2026-01-01", end: "2027-01-01" });
+    expect(periodContaining("2020-01-10", "2026-07-09", "monthly")).toEqual({
+      start: "2026-06-10",
+      end: "2026-07-10",
+    });
+    expect(periodContaining("2026-02-01", "2026-10-31", "quarterly")).toEqual({
+      start: "2026-08-01",
+      end: "2026-11-01",
+    });
+  });
+
+  it("includes the boundary day in the period it closes", () => {
+    expect(periodContaining("2026-01-31", "2026-03-31", "monthly")).toEqual({
+      start: "2026-02-28",
+      end: "2026-03-31",
+    });
+    expect(periodContaining("2026-01-15", "2026-02-15", "monthly").start).toBe("2026-01-15");
+    expect(periodContaining("2026-01-15", "2026-02-14", "monthly").start).toBe("2026-01-15");
+  });
+
+  it("rejects dates before the anchor", () => {
+    expect(() => periodContaining("2026-01-10", "2026-01-09", "monthly")).toThrow(ValidationError);
+  });
+
+  it("counts period days with exclusive end", () => {
+    expect(periodDays({ start: "2026-02-01", end: "2026-03-01" })).toBe(28);
+    expect(periodDays({ start: "2028-02-01", end: "2028-03-01" })).toBe(29);
+    expect(periodDays({ start: "2026-01-01", end: "2027-01-01" })).toBe(365);
+  });
+});
+
+describe("prorate", () => {
+  const april = { start: "2026-04-01", end: "2026-05-01" }; // 30 days
+  const price = money(3000, "USD");
+
+  it("charges in full when active the whole period", () => {
+    expect(prorate(price, april, "2026-03-01", "2026-06-01")).toEqual(price);
+    expect(prorate(price, april, "2026-04-01", "2026-05-01")).toEqual(price);
+  });
+
+  it("charges by active days with exclusive end", () => {
+    expect(prorate(price, april, "2026-04-11", "2026-05-01").minor).toBe(2000);
+    expect(prorate(price, april, "2026-04-01", "2026-04-02").minor).toBe(100);
+    expect(prorate(price, april, "2026-04-10", "2026-04-20").minor).toBe(1000);
+  });
+
+  it("clamps activity that started before the period", () => {
+    expect(prorate(price, april, "2026-03-20", "2026-04-11").minor).toBe(1000);
+  });
+
+  it("clamps activity that ends after the period", () => {
+    expect(prorate(price, april, "2026-04-21", "2026-06-15").minor).toBe(1000);
+  });
+
+  it("charges nothing without overlap", () => {
+    expect(prorate(price, april, "2026-05-01", "2026-06-01")).toEqual(money(0, "USD"));
+    expect(prorate(price, april, "2026-03-01", "2026-04-01").minor).toBe(0);
+    expect(prorate(price, april, "2026-04-10", "2026-04-10").minor).toBe(0);
+    expect(prorate(price, april, "2026-04-20", "2026-04-10").minor).toBe(0);
+  });
+
+  it("rounds half-up", () => {
+    // 1000 * 1/3 = 333.33 -> 333 ; 1000 * 2/3 = 666.67 -> 667
+    const period = { start: "2026-01-01", end: "2026-01-04" };
+    expect(prorate(money(1000, "USD"), period, "2026-01-01", "2026-01-02").minor).toBe(333);
+    expect(prorate(money(1000, "USD"), period, "2026-01-01", "2026-01-03").minor).toBe(667);
+    // 5 * 1/2 = 2.5 -> 3
+    const twoDays = { start: "2026-01-01", end: "2026-01-03" };
+    expect(prorate(money(5, "USD"), twoDays, "2026-01-02", "2026-01-03").minor).toBe(3);
+  });
+
+  it("uses the real length of February", () => {
+    const feb = { start: "2028-02-01", end: "2028-03-01" }; // leap year, 29 days
+    expect(prorate(money(2900, "USD"), feb, "2028-02-15", "2028-03-01").minor).toBe(1500);
+  });
+
+  it("keeps the currency", () => {
+    expect(prorate(money(1000, "JPY"), april, "2026-04-16", "2026-05-01")).toEqual(money(500, "JPY"));
+  });
+});
+
+describe("planChangeAdjustment", () => {
+  it("credits unused old plan and charges the new plan for the rest of the period", () => {
+    const result = planChangeAdjustment({
+      oldPrice: money(3000, "USD"),
+      newPrice: money(6000, "USD"),
+      anchor: "2026-01-01",
+      interval: "monthly",
+      changeOn: "2026-04-21", // 10 of 30 April days remain
+    });
+    expect(result.period).toEqual({ start: "2026-04-01", end: "2026-05-01" });
+    expect(result.credit).toEqual(money(1000, "USD"));
+    expect(result.charge).toEqual(money(2000, "USD"));
+    expect(result.net).toEqual(money(1000, "USD"));
+  });
+
+  it("gives a negative net for downgrades", () => {
+    const result = planChangeAdjustment({
+      oldPrice: money(6000, "USD"),
+      newPrice: money(3000, "USD"),
+      anchor: "2026-01-01",
+      interval: "monthly",
+      changeOn: "2026-04-21",
+    });
+    expect(result.credit.minor).toBe(2000);
+    expect(result.charge.minor).toBe(1000);
+    expect(result.net.minor).toBe(-1000);
+  });
+
+  it("an upgrade and an immediate downgrade cancel out", () => {
+    const base = { anchor: "2026-01-01", interval: "monthly" as const, changeOn: "2026-04-08" };
+    const up = planChangeAdjustment({ ...base, oldPrice: money(999, "USD"), newPrice: money(2999, "USD") });
+    const down = planChangeAdjustment({ ...base, oldPrice: money(2999, "USD"), newPrice: money(999, "USD") });
+    expect(up.net.minor + down.net.minor).toBe(0);
+  });
+
+  it("changing on the first day of a period swaps the full price", () => {
+    const result = planChangeAdjustment({
+      oldPrice: money(1000, "EUR"),
+      newPrice: money(2500, "EUR"),
+      anchor: "2026-01-31",
+      interval: "monthly",
+      changeOn: "2026-02-28",
+    });
+    expect(result.period).toEqual({ start: "2026-02-28", end: "2026-03-31" });
+    expect(result.credit.minor).toBe(1000);
+    expect(result.charge.minor).toBe(2500);
+    expect(result.net).toEqual(money(1500, "EUR"));
+  });
+
+  it("works for yearly plans", () => {
+    const result = planChangeAdjustment({
+      oldPrice: money(36500, "USD"),
+      newPrice: money(73000, "USD"),
+      anchor: "2025-07-01",
+      interval: "yearly",
+      changeOn: "2026-06-26", // 5 of 365 days remain
+    });
+    expect(result.credit.minor).toBe(500);
+    expect(result.charge.minor).toBe(1000);
+    expect(result.net.minor).toBe(500);
+  });
+
+  it("rejects mixed currencies and changes before the anchor", () => {
+    const base = { anchor: "2026-01-01", interval: "monthly" as const };
+    expect(() =>
+      planChangeAdjustment({ ...base, oldPrice: money(1, "USD"), newPrice: money(1, "EUR"), changeOn: "2026-01-05" }),
+    ).toThrow(CurrencyMismatchError);
+    expect(() =>
+      planChangeAdjustment({ ...base, oldPrice: money(1, "USD"), newPrice: money(2, "USD"), changeOn: "2025-12-31" }),
+    ).toThrow(ValidationError);
+  });
+});
