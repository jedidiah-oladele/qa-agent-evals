+
+
+def test_explicit_ttl_longer_than_default_overrides_it(inventory, clock):
+    reservation = inventory.reserve("TEE-001", 2, ttl=timedelta(hours=2))
+    assert reservation.expires_at == clock.now() + timedelta(hours=2)
+    clock.advance(timedelta(minutes=30))
+    assert inventory.available("TEE-001") == 3
+    inventory.commit(reservation.id)
+    assert inventory.on_hand("TEE-001") == 3
