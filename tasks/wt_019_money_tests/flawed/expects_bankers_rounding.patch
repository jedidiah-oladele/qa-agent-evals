+from decimal import Decimal
+
+import pytest
+
+from shopcore import CurrencyMismatchError, Money, UnknownCurrencyError, sum_money
+from shopcore.money import exponent_for, minor_unit, round_half_up
+
+
+def usd(amount: str) -> Money:
+    return Money.of(amount, "USD")
+
+
+# -- construction ----------------------------------------------------------
+
+def test_of_converts_int_and_str_exactly():
+    assert Money.of(5, "USD").amount == Decimal(5)
+    assert Money.of("0.10", "USD").amount == Decimal("0.10")
+    assert Money(Decimal("1.5"), "EUR").amount == Decimal("1.5")
+
+
+@pytest.mark.parametrize("bad", [1.1, True, False, None, [1]])
+def test_of_rejects_floats_bools_and_other_types(bad):
+    with pytest.raises(TypeError):
+        Money.of(bad, "USD")
+
+
+def test_constructor_also_rejects_bools():
+    with pytest.raises(TypeError):
+        Money(True, "USD")  # type: ignore[arg-type]
+
+
+def test_unknown_currency_is_rejected_everywhere():
+    with pytest.raises(UnknownCurrencyError):
+        Money.of("1", "XYZ")
+    with pytest.raises(UnknownCurrencyError):
+        Money.zero("usd")
+    with pytest.raises(UnknownCurrencyError):
+        exponent_for("BTC")
+    with pytest.raises(ValueError):  # UnknownCurrencyError is also a ValueError
+        minor_unit("XYZ")
+
+
+def test_minor_units_per_currency():
+    assert minor_unit("USD") == Decimal("0.01")
+    assert minor_unit("JPY") == Decimal("1")
+    assert minor_unit("KWD") == Decimal("0.001")
+
+
+# -- arithmetic ------------------------------------------------------------
+
+def test_add_subtract_negate():
+    assert usd("1.25") + usd("2.50") == usd("3.75")
+    assert usd("1.25") - usd("2.50") == usd("-1.25")
+    assert -usd("4.20") == usd("-4.20")
+
+
+def test_arithmetic_keeps_full_precision_until_quantize():
+    total = usd("0.333") + usd("0.333")
+    assert total.amount == Decimal("0.666")
+    assert total.quantize().amount == Decimal("0.67")
+
+
+def test_multiplication_by_int_and_decimal_only():
+    assert usd("2.50") * 3 == usd("7.50")
+    assert 3 * usd("2.50") == usd("7.50")
+    assert usd("10") * Decimal("0.075") == usd("0.750")
+    with pytest.raises(TypeError):
+        usd("1") * 1.5  # type: ignore[operator]
+    with pytest.raises(TypeError):
+        usd("1") * True  # type: ignore[operator]
+
+
+def test_mixing_currencies_raises_for_arithmetic():
+    with pytest.raises(CurrencyMismatchError):
+        usd("1") + Money.of("1", "EUR")
+    with pytest.raises(CurrencyMismatchError):
+        usd("1") - Money.of("1", "EUR")
+    with pytest.raises(TypeError):
+        usd("1") + 1  # type: ignore[operator]
+
+
+@pytest.mark.parametrize(
+    "compare",
+    [
+        lambda a, b: a < b,
+        lambda a, b: a <= b,
+        lambda a, b: a > b,
+        lambda a, b: a >= b,
+        lambda a, b: a.min(b),
+        lambda a, b: a.max(b),
+    ],
+)
+def test_comparing_different_currencies_raises(compare):
+    with pytest.raises(CurrencyMismatchError):
+        compare(usd("1"), Money.of("2", "EUR"))
+
+
+def test_comparisons_min_and_max():
+    a, b = usd("1"), usd("2")
+    assert a < b and not b < a
+    assert b > a and not a > b
+    assert a <= a and a >= a
+    assert a.min(b) == a and b.min(a) == a
+    assert a.max(b) == b and b.max(a) == b
+
+
+def test_sign_helpers():
+    assert Money.zero("USD").is_zero()
+    assert not Money.zero("USD").is_negative()
+    assert usd("-0.01").is_negative()
+    assert not usd("0.01").is_negative()
+    assert not usd("0.01").is_zero()
+
+
+# -- rounding --------------------------------------------------------------
+
+@pytest.mark.parametrize(
+    ("amount", "currency", "expected"),
+    [
+        ("2.345", "USD", "2.35"),
+        ("2.344", "USD", "2.34"),
+        ("0.125", "USD", "0.12"),
+        ("0.135", "USD", "0.14"),
+        ("-2.345", "USD", "-2.35"),
+        ("-0.125", "USD", "-0.13"),
+        ("0.005", "USD", "0.01"),
+        ("1234.5", "JPY", "1235"),
+        ("2.5", "JPY", "3"),
+        ("1.2345", "KWD", "1.235"),
+    ],
+)
+def test_quantize_rounds_half_away_from_zero(amount, currency, expected):
+    assert Money.of(amount, currency).quantize().amount == Decimal(expected)
+    assert round_half_up(Decimal(amount), currency) == Decimal(expected)
+
+
+def test_quantize_keeps_currency():
+    assert Money.of("1.2345", "KWD").quantize().currency == "KWD"
+
+
+def test_str_shows_the_rounded_amount():
+    assert str(usd("3.456")) == "USD 3.46"
+    assert str(usd("0.125")) == "USD 0.12"
+    assert str(Money.of("12", "JPY")) == "JPY 12"
+    assert str(Money.of("1.5", "KWD")) == "KWD 1.500"
+
+
+# -- allocate ----------------------------------------------------------------
+
+def test_allocate_even_split():
+    assert usd("9").allocate([1, 1, 1]) == [usd("3.00")] * 3
+
+
+def test_allocate_gives_leftover_to_earliest_on_ties():
+    parts = usd("10").allocate([1, 1, 1])
+    assert [p.amount for p in parts] == [Decimal("3.34"), Decimal("3.33"), Decimal("3.33")]
+    parts = usd("0.05").allocate([1, 1, 1, 1])
+    assert [p.amount for p in parts] == [Decimal("0.02"), Decimal("0.01"), Decimal("0.01"), Decimal("0.01")]
+
+
+def test_allocate_gives_leftover_to_largest_remainder_not_largest_weight():
+    # 5 cents over 1:2 -> exact shares 1.67 and 3.33; the first has the bigger remainder.
+    parts = usd("0.05").allocate([1, 2])
+    assert [p.amount for p in parts] == [Decimal("0.02"), Decimal("0.03")]
+
+
+def test_allocate_by_weights_never_loses_a_cent():
+    parts = usd("100.00").allocate([Decimal("19.99"), Decimal("12.50"), Decimal("9.95")])
+    assert [p.amount for p in parts] == [Decimal("47.10"), Decimal("29.45"), Decimal("23.45")]
+    assert sum_money(parts, "USD") == usd("100.00")
+
+
+def test_allocate_rounds_the_amount_first():
+    parts = usd("0.125").allocate([1, 1])
+    assert [p.amount for p in parts] == [Decimal("0.07"), Decimal("0.06")]
+
+
+def test_allocate_negative_amount_and_zero_weight():
+    parts = usd("-1.00").allocate([1, 0, 2])
+    assert [p.amount for p in parts] == [Decimal("-0.33"), Decimal("0.00"), Decimal("-0.67")]
+
+
+def test_allocate_whole_units_for_jpy_and_mills_for_kwd():
+    assert [p.amount for p in Money.of("1000", "JPY").allocate([1, 1, 1])] == [334, 333, 333]
+    assert [p.amount for p in Money.of("1", "KWD").allocate([1, 2])] == [
+        Decimal("0.333"),
+        Decimal("0.667"),
+    ]
+
+
+@pytest.mark.parametrize("weights", [[], [0, 0], [1, -1], [3, -1], [-1]])
+def test_allocate_rejects_bad_weights(weights):
+    with pytest.raises(ValueError):
+        usd("1").allocate(weights)
+
+
+# -- sum_money ---------------------------------------------------------------
+
+def test_sum_money():
+    assert sum_money([], "GBP") == Money.zero("GBP")
+    assert sum_money([usd("1.10"), usd("2.20")], "USD") == usd("3.30")
+    with pytest.raises(CurrencyMismatchError):
+        sum_money([usd("1")], "EUR")
