--- /dev/null
+++ b/src/invoice.ts
@@ -0,0 +1,176 @@
+import { CurrencyMismatchError, InvoiceStateError, ValidationError } from "./errors";
+import { type ISODate, addDays, compareDates } from "./dates";
+import { type Money, add, multiply, subtract, sum, zero } from "./money";
+
+export type InvoiceStatus = "draft" | "issued" | "paid";
+
+export interface InvoiceLine {
+  readonly description: string;
+  readonly quantity: number;
+  readonly unitPrice: Money;
+  /** Fraction, e.g. 0.2 for 20%. */
+  readonly taxRate: number;
+  /** Percentage off this line, 0-100. */
+  readonly discountPercent?: number;
+}
+
+export interface Payment {
+  readonly amount: Money;
+  readonly receivedOn: ISODate;
+}
+
+export interface InvoiceOptions {
+  /** Days between issue date and due date. */
+  readonly netDays?: number;
+}
+
+export class Invoice {
+  private readonly _lines: InvoiceLine[] = [];
+  private readonly _payments: Payment[] = [];
+  private _status: InvoiceStatus = "draft";
+  private _number: string | undefined;
+  private _issuedOn: ISODate | undefined;
+  readonly netDays: number;
+
+  constructor(
+    readonly currency: string,
+    options: InvoiceOptions = {},
+  ) {
+    this.netDays = options.netDays ?? 30;
+    if (!Number.isInteger(this.netDays) || this.netDays < 0) {
+      throw new ValidationError(`netDays must be a non-negative integer, got ${this.netDays}`);
+    }
+    zero(currency);
+  }
+
+  get status(): InvoiceStatus {
+    return this._status;
+  }
+  get number(): string | undefined {
+    return this._number;
+  }
+  get issuedOn(): ISODate | undefined {
+    return this._issuedOn;
+  }
+  get dueOn(): ISODate | undefined {
+    return this._issuedOn === undefined ? undefined : addDays(this._issuedOn, this.netDays);
+  }
+  get lines(): readonly InvoiceLine[] {
+    return this._lines;
+  }
+  get payments(): readonly Payment[] {
+    return this._payments;
+  }
+
+  private requireStatus(...allowed: InvoiceStatus[]): void {
+    if (!allowed.includes(this._status)) {
+      throw new InvoiceStateError(`invoice is ${this._status}; expected ${allowed.join(" or ")}`);
+    }
+  }
+
+  addLine(line: InvoiceLine): void {
+    this.requireStatus("draft");
+    if (line.unitPrice.currency !== this.currency) {
+      throw new CurrencyMismatchError(this.currency, line.unitPrice.currency);
+    }
+    if (!Number.isInteger(line.quantity) || line.quantity <= 0) {
+      throw new ValidationError(`quantity must be a positive integer, got ${line.quantity}`);
+    }
+    if (!(line.taxRate >= 0 && line.taxRate < 1)) {
+      throw new ValidationError(`taxRate must be in [0, 1), got ${line.taxRate}`);
+    }
+    const discount = line.discountPercent ?? 0;
+    if (!(discount >= 0 && discount <= 100)) {
+      throw new ValidationError(`discountPercent must be in [0, 100], got ${discount}`);
+    }
+    if (line.unitPrice.minor < 0) {
+      throw new ValidationError("unit price cannot be negative");
+    }
+    this._lines.push(line);
+  }
+
+  removeLine(index: number): void {
+    this.requireStatus("draft");
+    if (index < 0 || index >= this._lines.length) {
+      throw new ValidationError(`no line at index ${index}`);
+    }
+    this._lines.splice(index, 1);
+  }
+
+  /** Line amount after its discount, before tax. */
+  lineNet(line: InvoiceLine): Money {
+    const gross = multiply(line.unitPrice, line.quantity);
+    const discount = multiply(gross, (line.discountPercent ?? 0) / 100);
+    return subtract(gross, discount);
+  }
+
+  /** Tax for one line, rounded half-up on that line. */
+  lineTax(line: InvoiceLine): Money {
+    return multiply(this.lineNet(line), line.taxRate);
+  }
+
+  get subtotal(): Money {
+    return sum(
+      this._lines.map((l) => this.lineNet(l)),
+      this.currency,
+    );
+  }
+
+  get taxTotal(): Money {
+    return sum(
+      this._lines.map((l) => this.lineTax(l)),
+      this.currency,
+    );
+  }
+
+  get total(): Money {
+    return add(this.subtotal, this.taxTotal);
+  }
+
+  get amountPaid(): Money {
+    return sum(
+      this._payments.map((p) => p.amount),
+      this.currency,
+    );
+  }
+
+  get balance(): Money {
+    return subtract(this.total, this.amountPaid);
+  }
+
+  issue(number: string, issuedOn: ISODate): void {
+    this.requireStatus("draft");
+    if (this._lines.length === 0) {
+      throw new InvoiceStateError("cannot issue an invoice without lines");
+    }
+    if (!number.trim()) {
+      throw new ValidationError("invoice number is required");
+    }
+    addDays(issuedOn, 0); // validates the date
+    this._number = number;
+    this._issuedOn = issuedOn;
+    this._status = "issued";
+  }
+
+  recordPayment(amount: Money, receivedOn: ISODate): void {
+    this.requireStatus("issued");
+    if (amount.currency !== this.currency) {
+      throw new CurrencyMismatchError(this.currency, amount.currency);
+    }
+    if (amount.minor <= 0) {
+      throw new ValidationError("payment must be positive");
+    }
+    if (amount.minor > this.balance.minor) {
+      throw new ValidationError("payment exceeds the outstanding balance");
+    }
+    this._payments.push({ amount, receivedOn });
+    if (this.balance.minor === 0) {
+      this._status = "paid";
+    }
+  }
+
+  isOverdue(today: ISODate): boolean {
+    const due = this.dueOn;
+    return this._status === "issued" && due !== undefined && compareDates(today, due) > 0;
+  }
+}
diff --git a/src/numbering.ts b/src/numbering.ts
new file mode 100644
index 0000000..61ce027
--- /dev/null
+++ b/src/numbering.ts
@@ -0,0 +1,28 @@
+import { ValidationError } from "./errors";
+import { type ISODate, parseDate } from "./dates";
+
+/** Issues sequential invoice numbers such as "INV-2026-0042", restarting each year. */
+export class InvoiceNumberer {
+  private readonly counters = new Map<number, number>();
+
+  constructor(
+    readonly prefix = "INV",
+    readonly width = 4,
+  ) {
+    if (!/^[A-Z][A-Z0-9]*$/.test(prefix)) {
+      throw new ValidationError(`prefix must be upper-case alphanumeric, got ${JSON.stringify(prefix)}`);
+    }
+  }
+
+  /** Continue numbering from an existing series (e.g. after a restart). */
+  seed(year: number, lastIssued: number): void {
+    this.counters.set(year, lastIssued);
+  }
+
+  next(issuedOn: ISODate): string {
+    const { year } = parseDate(issuedOn);
+    const n = (this.counters.get(year) ?? 0) + 1;
+    this.counters.set(year, n);
+    return `${this.prefix}-${year}-${String(n).padStart(this.width, "0")}`;
+  }
+}
diff --git a/tests/invoice.test.ts b/tests/invoice.test.ts
new file mode 100644
index 0000000..e380d1b
--- /dev/null
+++ b/tests/invoice.test.ts
@@ -0,0 +1,127 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { CurrencyMismatchError, InvoiceStateError, ValidationError } from "../src/errors";
+import { Invoice } from "../src/invoice";
+import { money } from "../src/money";
+
+function sampleInvoice(): Invoice {
+  const invoice = new Invoice("USD", { netDays: 14 });
+  invoice.addLine({ description: "Consulting", quantity: 3, unitPrice: money(12_000, "USD"), taxRate: 0.075 });
+  invoice.addLine({ description: "Hosting", quantity: 1, unitPrice: money(1_999, "USD"), taxRate: 0.2 });
+  return invoice;
+}
+
+describe("Invoice totals", () => {
+  it("adds line nets and per-line rounded tax", () => {
+    const invoice = sampleInvoice();
+    expect(invoice.subtotal.minor).toBe(37_999);
+    // 36000 * 0.075 = 2700 ; 1999 * 0.2 = 399.8 -> 400
+    expect(invoice.taxTotal.minor).toBe(3_100);
+    expect(invoice.total.minor).toBe(41_099);
+  });
+
+  it("applies line discounts before tax", () => {
+    const invoice = new Invoice("USD");
+    invoice.addLine({ description: "Seats", quantity: 4, unitPrice: money(2_500, "USD"), taxRate: 0.1, discountPercent: 15 });
+    const line = invoice.lines[0]!;
+    expect(invoice.lineNet(line).minor).toBe(8_500);
+    expect(invoice.lineTax(line).minor).toBe(850);
+  });
+
+  it("an empty invoice totals zero", () => {
+    expect(new Invoice("EUR").total).toEqual(money(0, "EUR"));
+  });
+});
+
+describe("Invoice validation", () => {
+  let invoice: Invoice;
+  beforeEach(() => {
+    invoice = new Invoice("USD");
+  });
+
+  it("rejects lines in another currency", () => {
+    expect(() => invoice.addLine({ description: "x", quantity: 1, unitPrice: money(1, "EUR"), taxRate: 0 })).toThrow(
+      CurrencyMismatchError,
+    );
+  });
+
+  it.each([0, -1, 1.5])("rejects quantity %d", (quantity) => {
+    expect(() => invoice.addLine({ description: "x", quantity, unitPrice: money(1, "USD"), taxRate: 0 })).toThrow(
+      ValidationError,
+    );
+  });
+
+  it("rejects bad tax rates, discounts and prices", () => {
+    const base = { description: "x", quantity: 1, unitPrice: money(1, "USD"), taxRate: 0 };
+    expect(() => invoice.addLine({ ...base, taxRate: 1 })).toThrow(ValidationError);
+    expect(() => invoice.addLine({ ...base, taxRate: -0.1 })).toThrow(ValidationError);
+    expect(() => invoice.addLine({ ...base, discountPercent: 101 })).toThrow(ValidationError);
+    expect(() => invoice.addLine({ ...base, unitPrice: money(-1, "USD") })).toThrow(ValidationError);
+  });
+
+  it("validates netDays", () => {
+    expect(() => new Invoice("USD", { netDays: -1 })).toThrow(ValidationError);
+  });
+
+  it("removes lines by index while in draft", () => {
+    const inv = sampleInvoice();
+    inv.removeLine(0);
+    expect(inv.lines.map((l) => l.description)).toEqual(["Hosting"]);
+    expect(() => inv.removeLine(5)).toThrow(ValidationError);
+  });
+});
+
+describe("Invoice lifecycle", () => {
+  it("issues with a number and due date", () => {
+    const invoice = sampleInvoice();
+    invoice.issue("INV-2026-0001", "2026-10-20");
+    expect(invoice.status).toBe("issued");
+    expect(invoice.number).toBe("INV-2026-0001");
+    expect(invoice.dueOn).toBe("2026-11-03");
+  });
+
+  it("cannot issue an empty invoice or issue twice", () => {
+    expect(() => new Invoice("USD").issue("INV-1", "2026-01-01")).toThrow(InvoiceStateError);
+    const invoice = sampleInvoice();
+    invoice.issue("INV-1", "2026-01-01");
+    expect(() => invoice.issue("INV-2", "2026-01-02")).toThrow(InvoiceStateError);
+  });
+
+  it("is immutable once issued", () => {
+    const invoice = sampleInvoice();
+    invoice.issue("INV-1", "2026-01-01");
+    expect(() => invoice.addLine({ description: "late", quantity: 1, unitPrice: money(1, "USD"), taxRate: 0 })).toThrow(
+      InvoiceStateError,
+    );
+    expect(() => invoice.removeLine(0)).toThrow(InvoiceStateError);
+  });
+
+  it("tracks partial payments and becomes paid at zero balance", () => {
+    const invoice = sampleInvoice();
+    invoice.issue("INV-1", "2026-01-01");
+    invoice.recordPayment(money(41_000, "USD"), "2026-01-05");
+    expect(invoice.balance.minor).toBe(99);
+    expect(invoice.status).toBe("issued");
+    invoice.recordPayment(money(99, "USD"), "2026-01-06");
+    expect(invoice.status).toBe("paid");
+    expect(invoice.amountPaid.minor).toBe(41_099);
+  });
+
+  it("rejects overpayment, payments on drafts and wrong currencies", () => {
+    const invoice = sampleInvoice();
+    expect(() => invoice.recordPayment(money(1, "USD"), "2026-01-01")).toThrow(InvoiceStateError);
+    invoice.issue("INV-1", "2026-01-01");
+    expect(() => invoice.recordPayment(money(41_100, "USD"), "2026-01-02")).toThrow(ValidationError);
+    expect(() => invoice.recordPayment(money(0, "USD"), "2026-01-02")).toThrow(ValidationError);
+    expect(() => invoice.recordPayment(money(10, "EUR"), "2026-01-02")).toThrow(CurrencyMismatchError);
+  });
+
+  it("is overdue only after the due date while unpaid", () => {
+    const invoice = sampleInvoice();
+    expect(invoice.isOverdue("2030-01-01")).toBe(false);
+    invoice.issue("INV-1", "2026-01-01");
+    expect(invoice.isOverdue("2026-01-15")).toBe(false);
+    expect(invoice.isOverdue("2026-01-16")).toBe(true);
+    invoice.recordPayment(invoice.balance, "2026-01-20");
+    expect(invoice.isOverdue("2026-02-01")).toBe(false);
+  });
+});
diff --git a/tests/numbering.test.ts b/tests/numbering.test.ts
new file mode 100644
index 0000000..245ee4f
--- /dev/null
+++ b/tests/numbering.test.ts
@@ -0,0 +1,24 @@
+import { describe, expect, it } from "vitest";
+import { ValidationError } from "../src/errors";
+import { InvoiceNumberer } from "../src/numbering";
+
+describe("InvoiceNumberer", () => {
+  it("numbers sequentially and restarts each year", () => {
+    const numberer = new InvoiceNumberer();
+    expect(numberer.next("2026-12-30")).toBe("INV-2026-0001");
+    expect(numberer.next("2026-12-31")).toBe("INV-2026-0002");
+    expect(numberer.next("2027-01-01")).toBe("INV-2027-0001");
+    expect(numberer.next("2026-12-31")).toBe("INV-2026-0003");
+  });
+
+  it("supports custom prefix, width and seeding", () => {
+    const numberer = new InvoiceNumberer("CR", 6);
+    numberer.seed(2026, 41);
+    expect(numberer.next("2026-05-05")).toBe("CR-2026-000042");
+  });
+
+  it("rejects bad prefixes and dates", () => {
+    expect(() => new InvoiceNumberer("inv")).toThrow(ValidationError);
+    expect(() => new InvoiceNumberer().next("2026-02-30")).toThrow(ValidationError);
+  });
+});
