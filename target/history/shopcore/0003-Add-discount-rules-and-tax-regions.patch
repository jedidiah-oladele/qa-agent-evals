diff --git a/src/shopcore/discounts.py b/src/shopcore/discounts.py
new file mode 100644
index 0000000..1ee6114
--- /dev/null
+++ b/src/shopcore/discounts.py
@@ -0,0 +1,155 @@
+"""Discount rules and the stacking algorithm that combines them.
+
+Each discount turns the *remaining* (already discounted) amount of every line
+into a per-line discount. :func:`apply_discounts` runs discounts in priority
+order and decides between stacking and exclusive discounts.
+"""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+from datetime import datetime
+from decimal import Decimal
+
+from .errors import DiscountError
+from .money import Money, sum_money
+from .order import LineItem
+
+HUNDRED = Decimal(100)
+
+
+@dataclass(frozen=True, kw_only=True)
+class Discount(ABC):
+    """Common fields for every discount rule.
+
+    ``priority``: lower runs first. ``stackable``: whether the discount can be
+    combined with others. ``auto_apply``: applied without a coupon code.
+    ``expires_at``: the discount stops applying at this instant (exclusive).
+    """
+
+    code: str
+    priority: int = 100
+    stackable: bool = True
+    auto_apply: bool = False
+    expires_at: datetime | None = None
+
+    def is_active(self, now: datetime) -> bool:
+        return self.expires_at is None or now < self.expires_at
+
+    @abstractmethod
+    def compute(self, lines: Sequence[LineItem], remaining: Sequence[Money]) -> list[Money]:
+        """Return the discount for each line given each line's remaining amount."""
+
+
+def _allocate(amount: Money, lines_remaining: Sequence[Money], eligible: Sequence[bool]) -> list[Money]:
+    """Spread ``amount`` over eligible lines in proportion to their remaining value."""
+    currency = amount.currency
+    weights = [r.amount if ok else Decimal(0) for r, ok in zip(lines_remaining, eligible)]
+    if amount.is_zero() or sum(weights, Decimal(0)) <= 0:
+        return [Money.zero(currency) for _ in lines_remaining]
+    return amount.allocate(weights)
+
+
+@dataclass(frozen=True, kw_only=True)
+class PercentageDiscount(Discount):
+    """``percent`` off eligible lines, optionally limited to one category."""
+
+    percent: Decimal
+    category: str | None = None
+    max_discount: Money | None = None
+    min_subtotal: Money | None = None
+
+    def __post_init__(self) -> None:
+        if not (Decimal(0) < self.percent <= HUNDRED):
+            raise DiscountError(f"{self.code}: percent must be in (0, 100], got {self.percent}")
+
+    def compute(self, lines: Sequence[LineItem], remaining: Sequence[Money]) -> list[Money]:
+        currency = remaining[0].currency
+        if self.min_subtotal is not None:
+            gross = sum_money([line.gross for line in lines], currency)
+            if gross < self.min_subtotal:
+                return [Money.zero(currency) for _ in lines]
+        eligible = [self.category is None or line.product.category == self.category for line in lines]
+        base = sum_money([r for r, ok in zip(remaining, eligible) if ok], currency)
+        discount = (base * self.percent * Decimal("0.01")).quantize()
+        if self.max_discount is not None:
+            discount = discount.min(self.max_discount)
+        return _allocate(discount, remaining, eligible)
+
+
+@dataclass(frozen=True, kw_only=True)
+class FixedAmountDiscount(Discount):
+    """A fixed amount off the whole order, spread across lines by value."""
+
+    amount: Money
+    min_subtotal: Money | None = None
+
+    def __post_init__(self) -> None:
+        if self.amount.is_negative() or self.amount.is_zero():
+            raise DiscountError(f"{self.code}: amount must be positive")
+
+    def compute(self, lines: Sequence[LineItem], remaining: Sequence[Money]) -> list[Money]:
+        currency = remaining[0].currency
+        if self.min_subtotal is not None:
+            gross = sum_money([line.gross for line in lines], currency)
+            if gross < self.min_subtotal:
+                return [Money.zero(currency) for _ in lines]
+        available = sum_money(list(remaining), currency)
+        discount = self.amount.min(available)
+        return _allocate(discount, remaining, [True] * len(lines))
+
+
+@dataclass(frozen=True)
+class AppliedDiscount:
+    code: str
+    amount: Money
+
+
+@dataclass(frozen=True)
+class DiscountResult:
+    per_line: list[Money]
+    applied: list[AppliedDiscount] = field(default_factory=list)
+
+    def total(self, currency: str) -> Money:
+        return sum_money(self.per_line, currency)
+
+
+def _run(lines: Sequence[LineItem], discounts: Sequence[Discount], currency: str) -> DiscountResult:
+    remaining = [line.gross for line in lines]
+    per_line = [Money.zero(currency) for _ in lines]
+    applied: list[AppliedDiscount] = []
+    for discount in discounts:
+        amounts = discount.compute(lines, remaining)
+        amounts = [a.min(r) for a, r in zip(amounts, remaining)]
+        total = sum_money(amounts, currency)
+        if total.is_zero():
+            continue
+        remaining = [r - a for r, a in zip(remaining, amounts)]
+        per_line = [p + a for p, a in zip(per_line, amounts)]
+        applied.append(AppliedDiscount(discount.code, total))
+    return DiscountResult(per_line, applied)
+
+
+def apply_discounts(lines: Sequence[LineItem], discounts: Sequence[Discount], *, now: datetime) -> DiscountResult:
+    """Apply ``discounts`` to ``lines`` and return per-line discount amounts.
+
+    Expired discounts are ignored. Stackable discounts run together in
+    ``(priority, code)`` order, each on what the previous ones left. Every
+    non-stackable discount is evaluated on its own. The candidate that saves
+    the customer the most wins; on a tie the stacked combination wins.
+    """
+    if not lines:
+        return DiscountResult([])
+    currency = lines[0].gross.currency
+    active = sorted((d for d in discounts if d.is_active(now)), key=lambda d: (d.priority, d.code))
+    stackable = [d for d in active if d.stackable]
+    exclusive = [d for d in active if not d.stackable]
+
+    best = _run(lines, stackable, currency)
+    for discount in exclusive:
+        candidate = _run(lines, [discount], currency)
+        if candidate.total(currency) > best.total(currency):
+            best = candidate
+    return best
diff --git a/src/shopcore/tax.py b/src/shopcore/tax.py
new file mode 100644
index 0000000..409e2fe
--- /dev/null
+++ b/src/shopcore/tax.py
@@ -0,0 +1,136 @@
+"""Tax regions, rates and rounding.
+
+Rates are fractions (``Decimal('0.0725')`` is 7.25%). Regions can quote prices
+tax-exclusive (tax is added on top) or tax-inclusive (the price already
+contains tax, which is extracted for reporting).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass, field
+from decimal import Decimal
+from enum import StrEnum
+
+from .errors import TaxConfigError
+from .money import Money, round_half_up
+
+
+class TaxRounding(StrEnum):
+    PER_LINE = "per_line"
+    """Round each line's tax to the minor unit, then add the rounded amounts."""
+    PER_ORDER = "per_order"
+    """Add unrounded line taxes, round once, then spread back over the lines."""
+
+
+@dataclass(frozen=True, slots=True)
+class TaxRegion:
+    code: str
+    standard_rate: Decimal
+    reduced_rate: Decimal = Decimal(0)
+    reduced_categories: frozenset[str] = field(default_factory=frozenset)
+    exempt_categories: frozenset[str] = field(default_factory=frozenset)
+    prices_include_tax: bool = False
+
+    def __post_init__(self) -> None:
+        for rate in (self.standard_rate, self.reduced_rate):
+            if not (Decimal(0) <= rate < Decimal(1)):
+                raise TaxConfigError(f"{self.code}: rate {rate} must be in [0, 1)")
+        overlap = self.reduced_categories & self.exempt_categories
+        if overlap:
+            raise TaxConfigError(f"{self.code}: categories both reduced and exempt: {sorted(overlap)}")
+
+    def rate_for(self, tax_category: str) -> Decimal:
+        if tax_category in self.exempt_categories:
+            return Decimal(0)
+        if tax_category in self.reduced_categories:
+            return self.reduced_rate
+        return self.standard_rate
+
+
+class TaxTable:
+    """Lookup of tax regions by code."""
+
+    def __init__(self, regions: Iterable[TaxRegion] = ()) -> None:
+        self._regions: dict[str, TaxRegion] = {}
+        for region in regions:
+            self.register(region)
+
+    def register(self, region: TaxRegion) -> None:
+        self._regions[region.code] = region
+
+    def get(self, code: str) -> TaxRegion:
+        try:
+            return self._regions[code]
+        except KeyError:
+            raise TaxConfigError(f"no tax region configured for {code!r}") from None
+
+    def __contains__(self, code: object) -> bool:
+        return code in self._regions
+
+    def codes(self) -> list[str]:
+        return sorted(self._regions)
+
+
+DEFAULT_REGIONS: tuple[TaxRegion, ...] = (
+    TaxRegion("US-CA", Decimal("0.0725"), exempt_categories=frozenset({"food"})),
+    TaxRegion("US-NY", Decimal("0.04"), exempt_categories=frozenset({"food"})),
+    TaxRegion("US-OR", Decimal("0")),
+    TaxRegion(
+        "GB",
+        Decimal("0.20"),
+        reduced_rate=Decimal("0.05"),
+        reduced_categories=frozenset({"energy"}),
+        exempt_categories=frozenset({"food", "books", "children"}),
+        prices_include_tax=True,
+    ),
+    TaxRegion(
+        "DE",
+        Decimal("0.19"),
+        reduced_rate=Decimal("0.07"),
+        reduced_categories=frozenset({"food", "books"}),
+        prices_include_tax=True,
+    ),
+    TaxRegion("NG", Decimal("0.075"), exempt_categories=frozenset({"food", "medical"})),
+    TaxRegion(
+        "JP",
+        Decimal("0.10"),
+        reduced_rate=Decimal("0.08"),
+        reduced_categories=frozenset({"food"}),
+        prices_include_tax=True,
+    ),
+)
+
+
+def default_tax_table() -> TaxTable:
+    """A fresh table with the built-in example regions."""
+    return TaxTable(DEFAULT_REGIONS)
+
+
+def unrounded_tax(net: Money, rate: Decimal, *, inclusive: bool) -> Decimal:
+    """Tax contained in (inclusive) or owed on top of (exclusive) ``net``."""
+    if inclusive:
+        return net.amount * rate / (Decimal(1) + rate)
+    return net.amount * rate
+
+
+def compute_taxes(
+    nets: Sequence[Money],
+    rates: Sequence[Decimal],
+    *,
+    inclusive: bool = False,
+    rounding: TaxRounding = TaxRounding.PER_LINE,
+) -> list[Money]:
+    """Return the rounded tax for every line."""
+    if len(nets) != len(rates):
+        raise ValueError("nets and rates must have the same length")
+    if not nets:
+        return []
+    currency = nets[0].currency
+    raw = [unrounded_tax(net, rate, inclusive=inclusive) for net, rate in zip(nets, rates)]
+    if rounding is TaxRounding.PER_LINE:
+        return [Money(round_half_up(r, currency), currency) for r in raw]
+    total = Money(sum(raw, Decimal(0)), currency)
+    if total.is_zero() or sum(raw, Decimal(0)) <= 0:
+        return [Money.zero(currency) for _ in nets]
+    return total.allocate(raw)
diff --git a/tests/test_discounts.py b/tests/test_discounts.py
new file mode 100644
index 0000000..775d58f
--- /dev/null
+++ b/tests/test_discounts.py
@@ -0,0 +1,123 @@
+from datetime import UTC, datetime, timedelta
+from decimal import Decimal
+
+import pytest
+
+from shopcore import (
+    DiscountError,
+    FixedAmountDiscount,
+    LineItem,
+    Money,
+    PercentageDiscount,
+    apply_discounts,
+)
+
+NOW = datetime(2026, 3, 14, 12, 0, tzinfo=UTC)
+
+
+def usd(amount: str) -> Money:
+    return Money.of(amount, "USD")
+
+
+@pytest.fixture
+def lines(catalog):
+    return [LineItem(catalog.get("TEE-001"), 2), LineItem(catalog.get("MUG-001"), 1)]
+
+
+def amounts(result):
+    return [m.amount for m in result.per_line]
+
+
+def test_percentage_discount_spreads_by_line_value(lines):
+    result = apply_discounts(lines, [PercentageDiscount(code="TEN", percent=Decimal(10))], now=NOW)
+    # 10% of 52.48 = 5.248 -> 5.25, split 39.98 : 12.50
+    assert amounts(result) == [Decimal("4.00"), Decimal("1.25")]
+    assert result.total("USD") == usd("5.25")
+
+
+def test_percentage_discount_limited_to_category(lines):
+    result = apply_discounts(
+        lines, [PercentageDiscount(code="KITCHEN20", percent=Decimal(20), category="kitchen")], now=NOW
+    )
+    assert amounts(result) == [Decimal("0.00"), Decimal("2.50")]
+
+
+def test_percentage_discount_cap(lines):
+    discount = PercentageDiscount(code="HALF", percent=Decimal(50), max_discount=usd("10"))
+    assert apply_discounts(lines, [discount], now=NOW).total("USD") == usd("10.00")
+
+
+def test_min_subtotal_is_checked_against_gross(lines):
+    discount = PercentageDiscount(code="BIG", percent=Decimal(10), min_subtotal=usd("60"))
+    assert apply_discounts(lines, [discount], now=NOW).total("USD").is_zero()
+
+
+@pytest.mark.parametrize("percent", ["0", "-5", "100.01"])
+def test_percent_out_of_range(percent):
+    with pytest.raises(DiscountError):
+        PercentageDiscount(code="X", percent=Decimal(percent))
+
+
+def test_fixed_amount_capped_at_order_value(catalog):
+    lines = [LineItem(catalog.get("MUG-001"), 1)]
+    result = apply_discounts(lines, [FixedAmountDiscount(code="OFF20", amount=usd("20"))], now=NOW)
+    assert result.total("USD") == usd("12.50")
+
+
+def test_fixed_amount_rejects_non_positive():
+    with pytest.raises(DiscountError):
+        FixedAmountDiscount(code="X", amount=usd("0"))
+
+
+def test_stackable_discounts_apply_sequentially_by_priority(lines):
+    first = FixedAmountDiscount(code="FIVE", amount=usd("5"), priority=10)
+    second = PercentageDiscount(code="TEN", percent=Decimal(10), priority=20)
+    result = apply_discounts(lines, [second, first], now=NOW)
+    # 52.48 - 5.00 = 47.48; 10% of that = 4.748 -> 4.75
+    assert [a.code for a in result.applied] == ["FIVE", "TEN"]
+    assert result.total("USD") == usd("9.75")
+
+
+def test_same_priority_breaks_ties_by_code(lines):
+    a = PercentageDiscount(code="B-TEN", percent=Decimal(10))
+    b = FixedAmountDiscount(code="A-FIVE", amount=usd("5"))
+    assert [x.code for x in apply_discounts(lines, [a, b], now=NOW).applied] == ["A-FIVE", "B-TEN"]
+
+
+def test_best_of_exclusive_or_stacked_wins(lines):
+    stacked = [
+        PercentageDiscount(code="FIVE-PCT", percent=Decimal(5)),
+        FixedAmountDiscount(code="TWO", amount=usd("2")),
+    ]
+    exclusive = PercentageDiscount(code="VIP", percent=Decimal(15), stackable=False)
+    result = apply_discounts(lines, [*stacked, exclusive], now=NOW)
+    assert [a.code for a in result.applied] == ["VIP"]
+    assert result.total("USD") == usd("7.87")
+
+
+def test_stacked_wins_ties_against_exclusive(lines):
+    stacked = FixedAmountDiscount(code="FIVE", amount=usd("5"))
+    exclusive = FixedAmountDiscount(code="ALSO-FIVE", amount=usd("5"), stackable=False)
+    assert [a.code for a in apply_discounts(lines, [exclusive, stacked], now=NOW).applied] == ["FIVE"]
+
+
+def test_expired_discounts_are_ignored(lines):
+    expired = PercentageDiscount(code="OLD", percent=Decimal(10), expires_at=NOW)
+    live = PercentageDiscount(code="NEW", percent=Decimal(10), expires_at=NOW + timedelta(seconds=1))
+    result = apply_discounts(lines, [expired, live], now=NOW)
+    assert [a.code for a in result.applied] == ["NEW"]
+
+
+def test_discount_never_exceeds_line_value(catalog):
+    lines = [LineItem(catalog.get("MUG-001"), 1)]
+    discounts = [
+        FixedAmountDiscount(code="A", amount=usd("10"), priority=1),
+        FixedAmountDiscount(code="B", amount=usd("10"), priority=2),
+    ]
+    result = apply_discounts(lines, discounts, now=NOW)
+    assert result.total("USD") == usd("12.50")
+    assert [(a.code, a.amount) for a in result.applied] == [("A", usd("10.00")), ("B", usd("2.50"))]
+
+
+def test_no_lines_no_discount():
+    assert apply_discounts([], [PercentageDiscount(code="X", percent=Decimal(5))], now=NOW).per_line == []
diff --git a/tests/test_tax.py b/tests/test_tax.py
