diff --git a/src/shopcore/catalog.py b/src/shopcore/catalog.py
new file mode 100644
index 0000000..668be26
--- /dev/null
+++ b/src/shopcore/catalog.py
@@ -0,0 +1,64 @@
+"""Products and the catalog that holds them."""
+
+from __future__ import annotations
+
+from collections.abc import Iterator
+from dataclasses import dataclass
+
+from .errors import UnknownSkuError
+from .money import Money
+
+
+@dataclass(frozen=True, slots=True)
+class Product:
+    sku: str
+    name: str
+    unit_price: Money
+    category: str = "general"
+    tax_category: str = "standard"
+    weight_grams: int = 0
+
+    def __post_init__(self) -> None:
+        if not self.sku or self.sku != self.sku.strip():
+            raise ValueError(f"invalid sku: {self.sku!r}")
+        if self.unit_price.is_negative():
+            raise ValueError(f"{self.sku}: unit price cannot be negative")
+        if self.weight_grams < 0:
+            raise ValueError(f"{self.sku}: weight cannot be negative")
+
+
+class Catalog:
+    """An in-memory product catalog keyed by SKU."""
+
+    def __init__(self, products: list[Product] | None = None) -> None:
+        self._products: dict[str, Product] = {}
+        for product in products or []:
+            self.add(product)
+
+    def add(self, product: Product) -> None:
+        if product.sku in self._products:
+            raise ValueError(f"duplicate sku: {product.sku}")
+        self._products[product.sku] = product
+
+    def replace(self, product: Product) -> None:
+        if product.sku not in self._products:
+            raise UnknownSkuError(product.sku)
+        self._products[product.sku] = product
+
+    def get(self, sku: str) -> Product:
+        try:
+            return self._products[sku]
+        except KeyError:
+            raise UnknownSkuError(sku) from None
+
+    def by_category(self, category: str) -> list[Product]:
+        return [p for p in self._products.values() if p.category == category]
+
+    def __contains__(self, sku: object) -> bool:
+        return sku in self._products
+
+    def __len__(self) -> int:
+        return len(self._products)
+
+    def __iter__(self) -> Iterator[Product]:
+        return iter(self._products.values())
diff --git a/src/shopcore/order.py b/src/shopcore/order.py
new file mode 100644
index 0000000..541af43
--- /dev/null
+++ b/src/shopcore/order.py
@@ -0,0 +1,63 @@
+"""Orders and their line items."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+from .catalog import Product
+from .errors import CurrencyMismatchError
+from .money import Money, sum_money
+
+
+@dataclass(frozen=True, slots=True)
+class LineItem:
+    product: Product
+    quantity: int
+
+    def __post_init__(self) -> None:
+        if isinstance(self.quantity, bool) or not isinstance(self.quantity, int):
+            raise TypeError("quantity must be an int")
+        if self.quantity <= 0:
+            raise ValueError(f"{self.product.sku}: quantity must be positive")
+
+    @property
+    def sku(self) -> str:
+        return self.product.sku
+
+    @property
+    def gross(self) -> Money:
+        """Unit price times quantity, before discounts and tax."""
+        return self.product.unit_price * self.quantity
+
+    @property
+    def weight_grams(self) -> int:
+        return self.product.weight_grams * self.quantity
+
+
+@dataclass
+class Order:
+    """A mutable shopping order. Pricing happens in :mod:`shopcore.pricing`."""
+
+    currency: str
+    region: str
+    lines: list[LineItem] = field(default_factory=list)
+    coupon_codes: tuple[str, ...] = ()
+
+    def add(self, product: Product, quantity: int = 1) -> None:
+        """Add ``quantity`` units of ``product``, merging with an existing line."""
+        if product.unit_price.currency != self.currency:
+            raise CurrencyMismatchError(self.currency, product.unit_price.currency)
+        for index, line in enumerate(self.lines):
+            if line.sku == product.sku:
+                self.lines[index] = LineItem(product, line.quantity + quantity)
+                return
+        self.lines.append(LineItem(product, quantity))
+
+    def remove(self, sku: str) -> None:
+        self.lines = [line for line in self.lines if line.sku != sku]
+
+    def subtotal(self) -> Money:
+        return sum_money([line.gross for line in self.lines], self.currency)
+
+    def total_weight_grams(self) -> int:
+        return sum(line.weight_grams for line in self.lines)
diff --git a/tests/conftest.py b/tests/conftest.py
