index 0000000..9ee1040
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,30 @@
+from datetime import UTC, datetime
+from decimal import Decimal
+
+import pytest
+
+from shopcore import Catalog, FixedClock, Money, Product
+
+
+def usd(amount: str) -> Money:
+    return Money(Decimal(amount), "USD")
+
+
+@pytest.fixture
+def clock() -> FixedClock:
+    return FixedClock(datetime(2026, 3, 14, 12, 0, tzinfo=UTC))
+
+
+@pytest.fixture
+def catalog() -> Catalog:
+    return Catalog(
+        [
+            Product("TEE-001", "Plain tee", usd("19.99"), category="apparel", weight_grams=180),
+            Product("MUG-001", "Enamel mug", usd("12.50"), category="kitchen", weight_grams=350),
+            Product(
+                "BEAN-250", "Coffee beans 250g", usd("9.95"), category="grocery", tax_category="food", weight_grams=260
+            ),
+            Product("BOOK-042", "Field guide", usd("24.00"), category="books", tax_category="books", weight_grams=540),
+            Product("GIFT-10", "Gift card", usd("10.00"), category="gift", tax_category="exempt", weight_grams=0),
+        ]
+    )
diff --git a/tests/test_catalog.py b/tests/test_catalog.py
new file mode 100644
index 0000000..00e9c52
--- /dev/null
+++ b/tests/test_catalog.py
@@ -0,0 +1,45 @@
+import pytest
+
+from shopcore import Money, Product, UnknownSkuError
+
+
+def test_lookup_and_membership(catalog):
+    assert "TEE-001" in catalog
+    assert catalog.get("MUG-001").name == "Enamel mug"
+    assert len(catalog) == 5
+
+
+def test_unknown_sku_raises_keyerror_subclass(catalog):
+    with pytest.raises(UnknownSkuError) as info:
+        catalog.get("NOPE")
+    assert isinstance(info.value, KeyError)
+    assert str(info.value) == "NOPE"
+
+
+def test_duplicate_sku_rejected(catalog):
+    with pytest.raises(ValueError, match="duplicate"):
+        catalog.add(Product("TEE-001", "Again", Money.of("1", "USD")))
+
+
+def test_replace_requires_existing_sku(catalog):
+    catalog.replace(Product("TEE-001", "Tee v2", Money.of("21", "USD")))
+    assert catalog.get("TEE-001").name == "Tee v2"
+    with pytest.raises(UnknownSkuError):
+        catalog.replace(Product("NEW-1", "New", Money.of("1", "USD")))
+
+
+def test_by_category(catalog):
+    assert [p.sku for p in catalog.by_category("kitchen")] == ["MUG-001"]
+
+
+@pytest.mark.parametrize("sku", ["", " TEE", "TEE "])
+def test_invalid_skus(sku):
+    with pytest.raises(ValueError):
+        Product(sku, "x", Money.of("1", "USD"))
+
+
+def test_negative_price_and_weight_rejected():
+    with pytest.raises(ValueError):
+        Product("A", "x", Money.of("-1", "USD"))
+    with pytest.raises(ValueError):
+        Product("A", "x", Money.of("1", "USD"), weight_grams=-5)
diff --git a/tests/test_order.py b/tests/test_order.py
new file mode 100644
index 0000000..60a497b
--- /dev/null
+++ b/tests/test_order.py
@@ -0,0 +1,44 @@
+import pytest
+
+from shopcore import CurrencyMismatchError, LineItem, Money, Order, Product
+
+
+def test_add_merges_lines_for_same_sku(catalog):
+    order = Order("USD", "US-CA")
+    order.add(catalog.get("TEE-001"), 2)
+    order.add(catalog.get("MUG-001"))
+    order.add(catalog.get("TEE-001"), 1)
+    assert [(line.sku, line.quantity) for line in order.lines] == [("TEE-001", 3), ("MUG-001", 1)]
+
+
+def test_subtotal_and_weight(catalog):
+    order = Order("USD", "US-CA")
+    order.add(catalog.get("TEE-001"), 2)
+    order.add(catalog.get("MUG-001"), 1)
+    assert order.subtotal() == Money.of("52.48", "USD")
+    assert order.total_weight_grams() == 710
+
+
+def test_remove_line(catalog):
+    order = Order("USD", "US-CA")
+    order.add(catalog.get("TEE-001"))
+    order.remove("TEE-001")
+    assert order.lines == []
+    assert order.subtotal() == Money.zero("USD")
+
+
+def test_currency_mismatch_on_add():
+    order = Order("EUR", "DE")
+    with pytest.raises(CurrencyMismatchError):
+        order.add(Product("A", "x", Money.of("1", "USD")))
+
+
+@pytest.mark.parametrize("quantity", [0, -1])
+def test_line_quantity_must_be_positive(catalog, quantity):
+    with pytest.raises(ValueError):
+        LineItem(catalog.get("TEE-001"), quantity)
+
+
+def test_line_quantity_must_be_int(catalog):
+    with pytest.raises(TypeError):
+        LineItem(catalog.get("TEE-001"), 1.5)  # type: ignore[arg-type]
